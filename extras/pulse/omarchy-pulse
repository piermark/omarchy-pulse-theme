    def scene_kind(self) -> str:
        fl = os.environ.get("PULSE_DEMO_SCENE", "") if self.demo else ""
        if fl and os.path.exists(fl):   # the demo video: the scene of the moment, from its flag file
            return open(fl).read().strip() or "sphere"
        return str(self.scene_override or self.conf("pulse", "scene", default="sphere"))

    def demo_now(self) -> float:
        """The demo video's clock for the sky and the holidays: PULSE_DEMO_WARP holds a moment, which then runs on."""
        fl = os.environ.get("PULSE_DEMO_WARP", "") if self.demo else ""
        if fl and os.path.exists(fl):
            try:
                return float(open(fl).read().split()[0]) + time.time() - os.path.getmtime(fl)
            except (OSError, ValueError, IndexError):
                pass
        return time.time() + float(os.environ.get("PULSE_DEMO_SKY_OFFSET") or 0)

