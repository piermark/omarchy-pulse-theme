def port_of(cfg: dict | None = None) -> int:
    cfg = cfg if cfg is not None else load_config()
    return int(os.environ.get("PULSE_PORT") or (cfg.get("pulse") or {}).get("port") or DEFAULT_PORT)


def client(method: str, path: str, body: bytes = b"", ctype: str = "text/plain", timeout: float = 5) -> dict:
    port = port_of()
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", data=body if method == "POST" else None,
                                 method=method, headers={"X-Pulse-Token": token(), "Content-Type": ctype})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read() or b"{}")


def demo_net(hub) -> None:
    """The demo's network (made up): three switches, a firewall under attack, Wi-Fi, a small cluster, backups, an
    intruder, and now and then a syslog bolt and a live migration."""
    import random
    rnd = random.Random(7)
    def sw(name, n, peers):
        ports = [{"i": str(i), "name": f"ge-{i}", "up": rnd.random() < 0.8, "err": False, "util": round(rnd.random() * 0.5, 2)} for i in range(1, n + 1)]
        for k, (port, peer, jam) in enumerate(peers):
            ports[port].update(up=True, peer=peer, jam=jam, util=0.92 if jam else 0.4)
        return {"name": name, "up": True, "ports": ports, "peers": [p[1] for p in peers], "host": f"10.0.0.{len(name)}", "_raw": {}, "_t": 0}
    hosts = [{"name": f"pve-{i}", "up": True, "maint": i == 3, "cpu": 0.3,
              "vms": [{"id": f"{i}{k}", "name": f"vm-{i}{k}", "up": rnd.random() < 0.85} for k in range(4 + i * 3)]} for i in (1, 2, 3)]
    clients = [{"id": f"{rnd.getrandbits(32):08x}", "ap": rnd.choice(["ap-hall", "ap-office", "ap-garden"]), "signal": rnd.randint(-82, -38)} for _ in range(18)]
    t_move = 0.0
    flag = os.environ.get("PULSE_DEMO_NET", "")
    while True:
        now = time.time()
        if flag not in ("1", "") and not os.path.exists(flag):   # the demo video: only while its flag file exists
            with hub.lock:
                hub.net = None
            time.sleep(0.5)
            continue
        sws = [sw("core", 48, [(47, "access-1", False), (46, "access-2", True)]), sw("access-1", 24, [(23, "core", False)]),
               sw("access-2", 24, [(23, "core", True)])]
        if int(now) % 20 < 3:
            sws[1]["ports"][5]["err"] = True
        fw = (hub.net or {}).get("fw") or {"events": [], "vpn": 3}
        ev = [e for e in fw["events"] if now - e["t"] < 60]
        for _ in range(rnd.randint(0, 3)):
            cc = rnd.choice(["CN", "RU", "US", "NL", "BR", "VN", "IN", "DE"])
            ev.append({"src": "deny", "country": cc, "az": attack_az(cc, "", hub.location), "level": "info", "t": now + rnd.random()})
        if rnd.random() < 0.05:
            ev.append({"src": "ips", "country": "RU", "az": attack_az("RU", "", hub.location), "level": "crit", "t": now})
        if rnd.random() < 0.1:
            c = rnd.choice(clients)
            c["ap"] = rnd.choice(["ap-hall", "ap-office", "ap-garden"])
        moves = [m for m in ((hub.net or {}).get("dc") or {}).get("moves", []) if now - m["t"] < 30]
        if now - t_move > 25:
            t_move = now
            moves.append({"vm": "vm-12", "from": "pve-1", "to": "pve-2", "t": now})
        if rnd.random() < 0.04:
            hub.bolt({"sev": 2, "host": "access-1", "addr": "", "text": "link down ge-6", "t": now})
        with hub.lock:
            hub.net = {"switches": sws, "fw": {"events": ev[-60:], "vpn": 3},
                       "wifi": {"aps": ["ap-hall", "ap-office", "ap-garden"], "clients": clients},
                       "dc": {"hosts": hosts, "moves": moves},
                       "backups": [{"name": "nas-nightly", "state": "running", "t": now - 600},
                                   {"name": "pve-vms", "state": "ok", "t": now - 3600},
                                   {"name": "photos", "state": "failed", "t": now - 90000}],
                       "intruders": [{"level": "crit", "target": "pve-2", "what": "ssh brute force", "t": now - 20}]}
        time.sleep(1)


def cmd_term() -> int:
    """A small terminal on the city (beta): what you type and what it answers also appear on the wallpaper.
    It only reads: scan, ping, status. Actions (reboot, block...) come later, with confirmations."""
    def show(lines: list) -> None:
        for ln in lines:
            print(ln)
        quiet_client("/api/term", json.dumps({"lines": lines}).encode())

    def known() -> dict:
        try:
            st = client("GET", "/api/state")
        except Exception:   # noqa: BLE001
            return {}
        d = {x.get("name"): x.get("ip") for x in st.get("lan") or [] if x.get("name") and x.get("ip")}
        cfg = load_config().get("net") or {}
        for sw in cfg.get("switch") or []:
            if sw.get("name") and sw.get("host"):
                d[sw["name"]] = sw["host"]
        return d

    print("Pulse terminal (beta, read-only). help · scan · ping NAME · status · clear · exit")
    while True:
        try:
            line = input("pulse> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if not line:
            continue
        cmd0, *rest = line.split()
        quiet_client("/api/term", json.dumps({"lines": ["> " + line]}).encode())
        if cmd0 in ("exit", "quit"):
            return 0
        if cmd0 == "help":
            show(["scan          the devices Pulse knows and your neighbour table", "ping NAME|IP  three pings",
                  "status        switches, firewall, Wi-Fi, servers, backups", "clear         clear the wallpaper terminal"])
        elif cmd0 == "clear":
            quiet_client("/api/term", json.dumps({"clear": True}).encode())
        elif cmd0 == "scan":
            out = [f"{n:<20} {ip}" for n, ip in sorted(known().items())]
            if shutil.which("ip"):
                r = subprocess.run(["ip", "neigh"], capture_output=True, text=True, timeout=5)
                out += [" ".join(x.split()[:5]) for x in r.stdout.splitlines() if "REACHABLE" in x or "STALE" in x][:20]
            show(out or ["nothing found"])
        elif cmd0 == "ping" and rest:
            host = known().get(rest[0], rest[0])
            if not re.match(r"^[\w.:-]+$", host):
                show(["?"])
                continue
            r = subprocess.run(["ping", "-c", "3", "-W", "1", host], capture_output=True, text=True, timeout=10)
            last = [x for x in r.stdout.splitlines() if "packet loss" in x or "rtt" in x or "round-trip" in x]
            show([f"{rest[0]} ({host})"] + (last or [r.stderr.strip()[:80] or "no answer"]))
        elif cmd0 == "status":
            try:
                n = client("GET", "/api/state").get("net") or {}
            except Exception:   # noqa: BLE001
                n = {}
            sw = n.get("switches") or []
            show([f"switches  {sum(1 for x in sw if x['up'])}/{len(sw)} up, {sum(1 for x in sw for p in x['ports'] if p.get('err'))} ports with errors",
                  f"firewall  {len((n.get('fw') or {}).get('events', []))} blocked in the last minute, vpn {(n.get('fw') or {}).get('vpn')}",
                  f"wi-fi     {len((n.get('wifi') or {}).get('clients', []))} clients on {len((n.get('wifi') or {}).get('aps', []))} access points",
                  f"servers   {len((n.get('dc') or {}).get('hosts', []))} hosts",
                  "backups   " + (", ".join(f"{b['name']} {b['state']}" for b in n.get("backups") or []) or "none")])
        elif cmd0 in ("reboot", "shutdown", "block", "kill", "restart", "poweroff", "disable"):
            show(["this terminal only reads: actions come in a later version, with a confirmation"])
        else:
            show([f"{cmd0}: unknown (help)"])


