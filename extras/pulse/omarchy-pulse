            if u.path in ("/api/scene-prompt", "/api/scene-from-text", "/api/scene-describe"):   # 1.8: describe your world
                txt = body.decode("utf-8", "replace")
                panels = hub.scene_panels(hub.privacy())
                agent = str(hub.conf("creator", "agent", default="") or "").strip()
                try:
                    if u.path == "/api/scene-prompt":
                        self._send(200, json.dumps({"prompt": describe_prompt(txt, panels), "agent": bool(agent)}).encode())
                    elif u.path == "/api/scene-from-text":   # the reply of any agent, pasted: read and checked
