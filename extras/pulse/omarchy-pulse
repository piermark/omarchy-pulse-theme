                self._send(200, json.dumps({"ok": ok}).encode())
            elif u.path == "/api/doorbell":
                hub.doorbell()
                self._send(200, b'{"ok":true}')
            elif u.path == "/api/lights":
                eff = q.get("effect", "")
                ok = eff in ("alert", "doorbell", "lightning", "quake") and bool(hub.room_lights())
                if ok:
                    hub.room_effect(eff)
                self._send(200, json.dumps({"ok": ok}).encode())
            elif u.path == "/api/car":
                do = re.sub(r"[^a-z_]", "", q.get("do", ""))[:20]
                ok = hub.car_allowed(do)
                if ok:   # a car can take half a minute to answer: the command runs on its own
                    threading.Thread(target=hub.car_run, args=(do,), daemon=True).start()
                self._send(200, json.dumps({"ok": ok}).encode())
            elif u.path.startswith("/api/click/") and q.get("item", "").isdigit():
                ok = hub.click(urllib.parse.unquote(u.path[len("/api/click/"):]), int(q["item"]))
                self._send(200 if ok else 404, json.dumps({"ok": ok}).encode())
            elif u.path.startswith("/api/click/"):
                ok = hub.click(urllib.parse.unquote(u.path[11:]))
                self._send(200 if ok else 404, b'{"ok":true}' if ok else b"{}")
            else:
                self._send(404, b"{}")
    return H


def serve(hub: Hub, port: int) -> ThreadingHTTPServer:
    srv = ThreadingHTTPServer(("127.0.0.1", port), make_handler(hub, token(), port))
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv


# ---------------------------------------------------------------- the wallpaper window (GTK3 + layer shell + WebKit)

def dmabuf_guard(want_on: bool, state: Path) -> bool:
    """With the DMA-BUF renderer on, Pulse can die at once on some drivers (Wayland "Error 71"). Two starts in a row
    that do not live 30 seconds turn it off for good, until ~/.local/state/omarchy-pulse/dmabuf-crash is deleted."""
    guard, trial = state / "dmabuf-crash", state / "dmabuf-trial"
    if not want_on:
        return False
    if guard.exists():
        log("DMA-BUF renderer off: it made Pulse crash on start before (delete " + str(guard) + " to try it again)")
        return False
    try:
        n = int(trial.read_text().strip() or 0)
    except (OSError, ValueError):
        n = 0
    state.mkdir(parents=True, exist_ok=True)
    if n >= 2:
        guard.write_text(time.strftime("%Y-%m-%d %H:%M") + " WebKit's DMA-BUF renderer crashed Pulse twice on start\n")
        trial.unlink(missing_ok=True)
        log("DMA-BUF renderer off: Pulse crashed twice right after starting with it (dmabuf = \"on\" is ignored until "
            + str(guard) + " is deleted)")
        return False
    trial.write_text(str(n + 1))   # cleared after 30 seconds alive, or on a normal exit
    return True


def run_wall(url: str, gpu: str = "auto", dmabuf: str = "auto", prefer: str = "auto") -> int:
    off = gpu_offload_env(prefer, nvidia())
    if off:   # before WebKit starts: its web processes inherit it
        os.environ.update(off)
        log("drawing on the discrete GPU (gpu_prefer = \"discrete\"): " + " ".join(f"{k}={v}" for k, v in off.items()))
    use = dmabuf_guard(not dmabuf_disabled(dmabuf, nvidia()), STATE_DIR)
    trial = STATE_DIR / "dmabuf-trial"
    if not use:   # set before WebKit starts: its web processes inherit it
        os.environ["WEBKIT_DISABLE_DMABUF_RENDERER"] = "1"
    else:
        os.environ.pop("WEBKIT_DISABLE_DMABUF_RENDERER", None)
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("GtkLayerShell", "0.1")
        try:
            gi.require_version("WebKit2", "4.1")
        except ValueError:
            gi.require_version("WebKit2", "4.0")
        from gi.repository import Gdk, GLib, Gtk, GtkLayerShell, WebKit2
    except Exception as e:   # noqa: BLE001
        log(f"missing dependencies ({e}): run extras/install-live again")
        return 77
    if not GtkLayerShell.is_supported():
        log("this session does not support the layer shell (not Wayland/Hyprland?)")
        return 1
    disp = Gdk.Display.get_default()
    wins = []
    ctx = WebKit2.WebContext.get_default()
    try:
        ctx.set_cache_model(WebKit2.CacheModel.DOCUMENT_VIEWER)
    except Exception:   # noqa: BLE001
        pass
    for i in range(disp.get_n_monitors()):
        mon = disp.get_monitor(i)
        g = mon.get_geometry()
        win = Gtk.Window()
        GtkLayerShell.init_for_window(win)
        GtkLayerShell.set_namespace(win, "omarchy-pulse")
        GtkLayerShell.set_layer(win, GtkLayerShell.Layer.BOTTOM)   # above the still wallpaper, below every window
        GtkLayerShell.set_monitor(win, mon)
        for e in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(win, e, True)
        GtkLayerShell.set_exclusive_zone(win, -1)
        try:
            GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.NONE)
        except Exception:   # noqa: BLE001
            GtkLayerShell.set_keyboard_interactivity(win, False)
        wv = WebKit2.WebView()
        wv.set_background_color(Gdk.RGBA(0.02, 0.03, 0.06, 1))
        st = wv.get_settings()
        st.set_enable_developer_extras(False)
        try:   # the soundscape ([sound]) plays without a click on the wallpaper
            st.set_media_playback_requires_user_gesture(False)
        except Exception:   # noqa: BLE001
            pass
        # gpu = "auto" (WebKit decides; no GPU device -> CPU drawing, cheaper than a software GL), "always", "never"
        try:
            pol = (os.environ.get("PULSE_GPU") or gpu or "auto").upper()
            if pol == "AUTO" and not list(Path("/dev/dri").glob("renderD*")):
                pol = "NEVER"
            if pol in ("ALWAYS", "NEVER"):
                st.set_hardware_acceleration_policy(getattr(WebKit2.HardwareAccelerationPolicy, pol))
        except Exception:   # noqa: BLE001
            pass
        wv.connect("context-menu", lambda *a: True)
        wv.load_uri(f"{url}&mx={g.x}&my={g.y}&mon={i}&primary={1 if i == 0 else 0}" + os.environ.get("PULSE_URL_EXTRA", ""))

        def crashed(view, *a):   # the web process died: load the page again
            GLib.timeout_add_seconds(2, lambda: (view.reload(), False)[1])
            return True
        wv.connect("web-process-terminated", crashed)
        win.add(wv)
        win.show_all()
        wins.append(win)

    GLib.timeout_add_seconds(30, lambda: (trial.unlink(missing_ok=True), False)[1])   # alive: DMA-BUF is fine here

    def monitors_changed(*a):
        log("monitors changed: restarting")
        trial.unlink(missing_ok=True)
        Gtk.main_quit()
    disp.connect("monitor-added", monitors_changed)
    disp.connect("monitor-removed", monitors_changed)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, Gtk.main_quit)
    Gtk.main()
    return 1   # the unit starts it again (a monitor came or went)


