    def loop_media(self) -> None:
        while True:
            try:
                if self.builtin("media") is not False and shutil.which("playerctl"):
                    r = subprocess.run(["playerctl", "metadata", "--format",
                                        "{{status}}\t{{artist}}\t{{title}}\t{{position}}\t{{mpris:length}}\t{{playerName}}\t{{mpris:artUrl}}"],
                                       capture_output=True, text=True, timeout=3)
                    parts = r.stdout.strip("\n").split("\t")
                    if r.returncode == 0 and len(parts) >= 6 and parts[0] in ("Playing", "Paused"):
                        self.cover_url = parts[6].strip() if len(parts) > 6 and parts[0] == "Playing" else ""
                        pos = int(parts[3] or 0) / 1e6
                        ln = int(parts[4] or 0) / 1e6
                        self.set_widget("media", title="now playing", type="media", slot="left", order=20,
                                        data={"status": parts[0], "artist": parts[1], "title": parts[2], "pos": pos,
                                              "len": ln, "player": parts[5]})
                    else:
                        self.cover_url = ""
                        self.drop_widget("media")
            except Exception:   # noqa: BLE001
                self.cover_url = ""
                self.drop_widget("media")
            time.sleep(3)

    # -- 1.6: the city takes the colours of the album that is playing ([music] colors = true)
    def cover_now(self) -> str:
        fl = os.environ.get("PULSE_DEMO_COVER", "") if self.demo else ""
        if fl:   # the demo video: the cover of the moment, from its flag file (made-up covers)
            try:
                return open(fl).read().strip()
            except OSError:
                return ""
        return self.cover_url

    def cover_bytes(self) -> tuple | None:
        """The cover of what plays now (Spotify, YouTube Music, any MPRIS player): (bytes, type), from the player's
        own file or its https address; cached by address. Nothing is sent anywhere."""
        url = self.cover_now()
        if not url:
            return None
        if self.cover_cache.get("url") == url:
            return self.cover_cache.get("val")
        val = None
        try:
            if url.startswith("file://"):
                f = Path(urllib.parse.unquote(url[7:]))
                if f.is_file() and f.stat().st_size <= 8_000_000:
                    val = (f.read_bytes(), WALL_TYPES.get(f.suffix.lower(), "image/jpeg"))
            elif url.startswith("https://"):
                req = urllib.request.Request(url, headers={"User-Agent": "omarchy-pulse/" + VERSION})
                with urllib.request.urlopen(req, timeout=8) as r:
                    ct = r.headers.get("Content-Type", "image/jpeg").split(";")[0]
                    if ct.startswith("image/"):
                        val = (r.read(8_000_000), ct)
        except Exception as e:   # noqa: BLE001
            log(f"cover: {e}")
        self.cover_cache = {"url": url, "val": val}
        return val

    def cover_ui(self) -> dict | None:
        url = self.cover_now()
        if self.conf("music", "colors", default=False) is not True or not url or self.privacy():
            return None
        return {"v": hashlib.sha1(url.encode()).hexdigest()[:12]}

    def loop_notifications(self) -> None:
        while True:
            try:
                if self.builtin("notifications") is not False:
                    hours = float(self.builtin("notifications_hours", 3) or 0)
                    items = visible_notifications(notification_history(), hours, self.notes_cleared, read_battery(),
                                                  float(self.builtin("notifications_quick", 120) or 0),
                                                  tuple(str(a).lower() for a in (self.builtin("notifications_quick_apps", list(QUICK_APPS)) or [])))
                    self.agents_from_notes(items)
                    if items:
                        self.set_widget("notifications", title="notifications", type="list", slot="center", order=40,
                                        private=True, data={"items": items[:5]}, click="clear")
                    else:
                        self.drop_widget("notifications")
            except Exception:   # noqa: BLE001
                pass
            time.sleep(5)

    def agents_from_notes(self, items: list) -> None:
        """1.6: agents that live in the cloud (Claude Duet, Meta Muse...) have no hooks: their desktop notifications
        become a drone. [agents] from_notifications = ["Claude Duet"]; only the app's name decides, never the text."""
        names = [str(x) for x in ((self.conf("agents", default={}) or {}).get("from_notifications") or [])][:12]
        if not names:
            return
        seen = getattr(self, "_agent_note_t", time.time() - 60)
        for it in sorted(items, key=lambda x: x.get("t") or 0):
            t = it.get("t") or 0
            if t <= seen:
                continue
            seen = t
            where = f"{it.get('right', '')} {it.get('title', '')}".lower()
            who = next((nm for nm in names if nm.lower() in where), None)
            if who:
                ask = re.search(r"approv|approval|confirm|needs? (you|your|input)|waiting|review|permission",
                                f"{it.get('title', '')} {it.get('text', '')}", re.I)
                self.set_agent(who.lower()[:32], "waiting" if ask else "done", "needs your OK" if ask else "finished")
        self._agent_note_t = seen

    def loop_theme(self) -> None:
        while True:
            try:
                t = read_theme()
                with self.lock:
                    self.theme = t
            except Exception as e:   # noqa: BLE001
                log(f"theme: {e}")
            try:
                self.reload()
                self.expire_agents()
                self.check_focus()
            except Exception as e:   # noqa: BLE001
                log(f"reload: {e}")
            time.sleep(3)

    # -- Hyprland: window coverage on each monitor and screen sharing (privacy)
    def loop_hypr(self) -> None:
        threading.Thread(target=self.loop_hypr_refresh, daemon=True).start()
        while True:
            path = hypr_socket()
            if not path:
                time.sleep(5)
                continue
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.connect(path)
                self.hypr_dirty.set()
                buf = b""
                while True:
                    data = s.recv(4096)
                    if not data:
                        break
                    buf += data
                    *lines, buf = buf.split(b"\n")
                    for line in lines:
                        ev, _, arg = line.decode("utf-8", "replace").partition(">>")
                        if ev == "screencast":
                            on = arg.split(",")[0] == "1"
                            if on != self.screencast:
                                log("screen sharing " + ("started: privacy on" if on else "stopped"))
                            self.screencast = on
                        elif ev in ("workspace", "workspacev2", "openwindow", "closewindow", "movewindow", "movewindowv2",
                                    "fullscreen", "focusedmon", "focusedmonv2", "changefloatingmode", "monitoradded",
                                    "monitorremoved", "activespecial", "minimized"):
                            self.hypr_dirty.set()
                s.close()
            except Exception:   # noqa: BLE001
                pass
            time.sleep(2)

    def loop_hypr_refresh(self) -> None:
        while True:
            self.hypr_dirty.wait(10)
            time.sleep(0.25)
            self.hypr_dirty.clear()
            try:
                def query(what):
                    result = subprocess.run(["hyprctl", "-j", what], capture_output=True, timeout=3,
                                            env=hypr_env(), check=True)
                    data = json.loads(result.stdout)
                    if not isinstance(data, list):
                        raise ValueError("invalid Hyprland response")
                    return data
                mons = query("monitors")
                wss = {w["id"]: w for w in query("workspaces")}
                clients = query("clients")
                out = {}
                for m in mons:
                    w = wss.get((m.get("activeWorkspace") or {}).get("id"), {})
                    sp = (m.get("specialWorkspace") or {}).get("id")
                    out[f"{m.get('x', 0)},{m.get('y', 0)}"] = {"name": m.get("name"), "windows": w.get("windows", 0),
                        "fullscreen": bool(w.get("hasfullscreen")) or bool(sp),
                        "covered": monitor_covered(m, clients)}
                act = next(((m.get("activeWorkspace") or {}).get("id", 0) for m in mons if m.get("focused")), 0)
                with self.lock:
                    self.mons = out
                    self.tower = hypr_floors(list(wss.values()), clients, act)   # 1.6: the workspaces tower
                saver = any("screensaver" in str(c.get("class", "")).lower() for c in clients)
                if self.conf("presence", "lock", default=True) is not False:
                    if saver and not self.away:
                        self.set_away(True, "screensaver")
                    elif not saver and self.away and self.away.get("why") == "screensaver" and not self.locked:
                        self.set_away(False)
            except Exception:   # noqa: BLE001 - fail open if the compositor state is unavailable
                with self.lock:
                    self.mons = {}

