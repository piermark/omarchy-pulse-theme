    # -- earthquakes (USGS): the city shakes, a wave comes from where it happened
    def loop_quakes(self) -> None:
        first, warned = True, 0.0
        while True:
            q = self.conf("quakes", default={}) or {}
            if q.get("enabled") is False or self.demo:
                time.sleep(60)
                continue
            now = time.time()
            try:
                j = http_json("https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson")
                for f in j.get("features") or []:
                    fid, p, g = f.get("id"), f.get("properties") or {}, (f.get("geometry") or {}).get("coordinates") or []
                    if not fid or fid in self.quake_seen or len(g) < 2:
                        continue
                    self.quake_seen.add(fid)
                    if first or now - (p.get("time") or 0) / 1000 > 3600:
                        continue   # the first look, and old ones, only fill the memory
                    mag = float(p.get("mag") or 0)
                    dist, az = (distance_bearing(self.location[0], self.location[1], g[1], g[0]) if self.location else (99999, 90))
                    near_km = float(q.get("near_km", 500) or 500)
                    tsu = p.get("tsunami") == 1   # USGS sets it when a tsunami warning centre has issued a message
                    if tsu or mag >= float(q.get("min_world", 6) or 6) or (dist < near_km and mag >= float(q.get("min_near", 3) or 3)):
                        self.quake_event(mag, str(p.get("place") or ""), dist, az, near_km, tsu,
                                         float(q.get("tsunami_km", 1500) or 1500))
                if len(self.quake_seen) > 2000:
                    self.quake_seen = set(list(self.quake_seen)[-1000:])
                first = False
            except Exception as e:   # noqa: BLE001
                if now - warned > 3600:
                    warned = now
                    log(f"quakes: {e}")
            time.sleep(max(60, int(q.get("every", 300) or 300)))

    def quake_event(self, mag: float, place: str, dist: float, az: float, near_km: float = 500, tsunami: bool = False,
                    tsunami_km: float = 1500) -> None:
        place, near = place[:40], dist < near_km
        sea_near = tsunami and dist < tsunami_km
        self.stat("quakes")
        if near or sea_near:
            self.room_effect("quake")
            self.phone("earth", ("Tsunami message · " if sea_near else "Earthquake near you · ") + f"M{mag:.1f}",
                       f"{place} · {dist:.0f} km", "ocean" if sea_near else "warning")
        self.add_fx("quake", f"M{mag:.1f} · {place} · {dist:,.0f} km" + (" · TSUNAMI" if tsunami else ""),
                    mag=mag, az=az, near=1 if near else 0, tsunami=1 if tsunami else 0)
        self.note("earth", f"M{mag:.1f} earthquake · {place}" + (" · tsunami message" if tsunami else ""),
                  "crit" if sea_near else "warn" if near or tsunami else "info")
        if sea_near:
            self.raise_alert("tsunami", f"tsunami message · M{mag:.1f}", f"{place} · {dist:.0f} km · check your local authorities", "crit",
                             speak=False)
        elif near and mag >= 4:
            self.raise_alert("quake", f"earthquake M{mag:.1f} near you", f"{place} · {dist:.0f} km", "warn", speak=False)
        self.say(self.T("quake", mag=f"{mag:.1f}", place=place) + (" " + self.T("tsunami") if tsunami else ""), "earth")

    # -- the timelapse: the page sends a picture of the scene (no panels, no names) every few minutes
    def timelapse_frame(self, mon: str, data: bytes) -> bool:
        t = self.conf("timelapse", default={}) or {}
        if t.get("enabled") is False or self.privacy() or not data.startswith(b"\xff\xd8") or len(data) > 1_500_000:
            return False
        d = STATE_DIR / "timelapse" / time.strftime("%Y-%m-%d") / re.sub(r"[^0-9,-]", "", mon)[:16]
        d.mkdir(parents=True, exist_ok=True)
        (d / (time.strftime("%H%M%S") + ".jpg")).write_bytes(data)
