                        self._send(200, json.dumps({"design": d, "notes": notes}).encode())
                except ValueError as e:
                    self._send(400, json.dumps({"error": str(e)}).encode())
                return
            if u.path in ("/api/package-check", "/api/package-install"):   # 1.7: a .pulse file opened in the editor
                try:
                    pkg = json.loads(body or b"{}")
                except ValueError:
                    self._send(400, b'{"error":"not a .pulse file"}')
