                return
            if u.path == "/api/noc":   # 1.5 beta: on, off, ack (the incident is over)
                do = q.get("do", "")
                with hub.lock:
                    if do in ("on", "off"):
                        hub.noc_override = do == "on"
                    if do in ("ack", "off"):
