def city_key(name) -> str:
    """A city name (any language, any accents) -> the key of a skyline Pulse can draw, or ""."""
    n = unicodedata.normalize("NFKD", str(name or "")).encode("ascii", "ignore").decode().lower()
    n = re.sub(r"[^a-z0-9]+", "-", n).strip("-")
    n = CITY_ALIASES.get(n, n)
    return n if n in CITY_KEYS else ""


