def country_code(v: str) -> str:
    v = str(v or "").strip()
    if len(v) == 2 and v.upper() in COUNTRIES:
        return v.upper()
    return COUNTRY_BY_NAME.get(v.lower(), "")


def bearing(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    """The direction (degrees from north) from (lat1, lon1) to (lat2, lon2) on the globe."""
    import math
    p1, p2, dl = math.radians(lat1), math.radians(lat2), math.radians(lon2 - lon1)
    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    return math.degrees(math.atan2(y, x)) % 360


def attack_az(country: str, ip: str, home) -> float:
    """Where an attack comes from in your sky: the real direction of its country, or (no country) a direction that
    stays the same for the same address."""
    cc = country_code(country)
    if cc and home:
        _, la, lo = COUNTRIES[cc]
        return round(bearing(home[0], home[1], la, lo), 1)
    return float(int(hashlib.sha1(str(ip).encode()).hexdigest()[:6], 16) % 360)


