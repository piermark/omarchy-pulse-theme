    def scene_space(self, priv: bool) -> dict:
        """1.7: the sky a scene can follow: the Sun's height, the Moon, the planes, the ISS, Starlink, Kp, the next launch.
        Only heights, directions and counts (no position of yours); flight numbers hidden while private."""
        n = self.night or {}
        planes = self.sky.get("planes", []) if time.time() - self.sky.get("t", 0) < 120 else []
        sats = [x for x in ((self.starlink or {}).get("sats") or []) if (x or {}).get("el", 0) > 0]
        iss = (self.space or {}).get("iss") or {}
        la = (self.space or {}).get("launch") or {}
        return {"sun": (n.get("sun") or {}).get("el"), "moon": round(((n.get("moon") or {}).get("lit") or 0) * 100) if n.get("moon") else None,
                "planes": len(planes), "list": [{"az": x.get("az"), "el": x.get("el"), "flight": "" if priv else x.get("flight", "")} for x in planes[:12]],
                "iss": iss.get("el") or 0, "starlink": len(sats), "kp": (self.space or {}).get("kp"),
                "launchIn": round(la["net"] - time.time()) if la.get("net") else None}

    ROWS_SKIP = BUILTIN_IDS | {"car", "doorbell", "pulse.toml", "motion"}

    @staticmethod
    def panel_rows(d: dict, priv: bool = False) -> list:
        """The rows of a panel with a list, a status or a table: [{name, level, value}] (32 at most). Never notes or
        text; names empty while private. A table row [name, status]: "up 3d" is ok, "exited" crit."""
        rows = []
        if not isinstance(d, dict) or not (isinstance(d.get("items"), list) or isinstance(d.get("rows"), list)):
            return rows
        for it in (d.get("items") or d.get("rows") or [])[:32]:
            if isinstance(it, dict):
                v = it.get("value")
                rows.append({"name": "" if priv else str(it.get("title") or "")[:40], "level": it.get("level") if it.get("level") in LEVELS else "",
                             "value": v if isinstance(v, (int, float)) and not isinstance(v, bool) else None})
            elif isinstance(it, (list, tuple)) and it:
                st = str(it[1] if len(it) > 1 else "").lower()
                lv = ("warn" if "unhealthy" in st or "restarting" in st or "paused" in st else "ok" if st.startswith(("up", "running", "ok", "online"))
                      else "crit" if st.startswith(("exited", "dead", "down", "stopped", "failed", "offline", "error")) else "")
                rows.append({"name": "" if priv else str(it[0])[:40], "level": lv, "value": None})
        return rows

    def datacenter_state(self) -> list:
        """1.8: your datacenter as a district of the city: [datacenter] panels = ["proxmox", "docker"] -> one building for
        every row of those panels (a VM, a container, a host), in the colour of its state. Off until you name a panel;
        private panels are never in it, names are empty while you share the screen."""
        ids = self.conf("datacenter", "panels", default=[]) or (["homelab", "containers"] if self.demo else [])
        if not isinstance(ids, list):
            return []
        priv, out, left = self.privacy(), [], 36
        for pid in [str(x)[:40] for x in ids[:6]]:
            w = self.widgets.get(pid)
            if not w or w.get("private") or pid in self.ROWS_SKIP:
                continue
            rows = self.panel_rows(w.get("data") or {}, priv)[:left]
            if rows:
                left -= len(rows)
                out.append({"id": pid, "title": "" if priv else str(w.get("title") or pid)[:24], "rows": rows})
        return out

    def scene_panels(self, priv: bool = False) -> dict:
        """1.7: your panels ([[source]], push, Home Assistant...), so a shape can follow them: the number of a stat or a
        gauge {id: {value, min, max, unit}}, and the rows of a list, a status or a table {id: {rows: [{name, level,
        value}]}} so a shape can repeat once per row (a tower per VM). Never their notes or text; names empty while
        private; a panel marked private, and Pulse's own (system, notifications, the car...), are never in it."""
        out = {}
        for w in list(self.widgets.values())[:64]:
            d = w.get("data") or {}
            wid = str(w.get("id", ""))[:40]
            if w.get("private") or not isinstance(d, dict):
                continue
            if w.get("type") in ("stat", "gauge") and isinstance(d.get("value"), (int, float)):
                e = {"value": d["value"], "unit": str(d.get("unit") or w.get("unit_override") or "")[:8]}
                if isinstance(d.get("min"), (int, float)) and isinstance(d.get("max"), (int, float)):
                    e["min"], e["max"] = d["min"], d["max"]
                out[wid] = e
            elif wid not in self.ROWS_SKIP:
                rows = self.panel_rows(d, priv)
                if rows:
                    out[wid] = {"rows": rows}
        return out

    def skyline(self) -> str:
        """The real city behind the towers: "auto" follows the weather's city (not while sharing the screen)."""
        sk = self.skyline_override or str(self.conf("pulse", "skyline", default="auto") or "auto")
        if sk in ("off", "none", "generic", "false"):
            return ""
        if sk == "auto":
            if self.privacy():
                return ""
            return city_key((self.weather or {}).get("city") or self.conf("pulse", "city", default=""))
        return city_key(sk)

    def public_digest(self):
        d = self.digest
        if not d or time.time() - d["until"] > 600:
            return None
        if self.privacy():
            return {**d, "lines": [x for x in d["lines"] if not x.get("private")]}
        return d

    def colors(self) -> dict:
        """The theme's colours, or a [colors] preset, with any single colour of [colors] on top."""
        c = self.conf("colors", default={}) or {}
        preset = str(c.get("preset", "theme"))
        base = dict(self.theme.get("colors") or {}) if preset == "theme" or preset not in PRESETS else \
            {COLOR_KEYS[k]: v for k, v in PRESETS[preset].items()}
        for k, v in c.items():
            if k in COLOR_KEYS and isinstance(v, str) and re.match(r"^#[0-9a-fA-F]{6}$", v):
                base[COLOR_KEYS[k]] = v
        return {"name": self.theme.get("name", ""), "colors": base, "preset": preset}

