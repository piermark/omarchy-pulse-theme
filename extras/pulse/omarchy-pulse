def hook_snippet(kind: str) -> str:
    """The exact text to paste in an agent's config so it tells Pulse what it does."""
    where, _, evs = HOOK_SETUP[kind]
    if kind == "hermes":
        body = "hooks:\n" + "".join(f"  {e}:\n    - command: \"omarchy-pulse hook hermes\"\n      timeout: 5\n" for e in evs)
        return f"# {where}\n{body}"
    if kind == "copilot":
        hooks = {e: [{"type": "command", "bash": f"omarchy-pulse hook copilot {e}", "timeoutSec": 5}] for e in evs}
        return f"// {where}\n" + json.dumps({"version": 1, "hooks": hooks}, indent=2)
    unit = "timeout"
    hooks = {e: [{"hooks": [{"type": "command", "command": f"omarchy-pulse hook {kind}", unit: 5000 if kind == "gemini" else 5}]}]
             for e in evs}
    if kind == "claude" or kind == "gemini":
        return f"// {where}: merge this \"hooks\" block into the file\n" + json.dumps({"hooks": hooks}, indent=2)
    return f"// {where}\n" + json.dumps({"hooks": hooks}, indent=2)
