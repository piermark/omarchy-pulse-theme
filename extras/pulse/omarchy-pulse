                print(f"# {k}: omarchy-pulse hook install {k}\n")
        print("# Codex: approve the new hooks once with /hooks. Hermes: it asks once for each hook (or hooks_auto_accept: true).\n"
              "# Grok Build also reads Claude Code's hook files: with those it already shows up, named claude.\n"
              "# Claude Duet, Meta Muse and other agents without hooks: [agents] from_notifications = [\"Claude Duet\"]\n"
