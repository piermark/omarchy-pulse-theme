                "colors": "picture" if str(self.conf("pulse", "wallpaper_colors", default="theme")) == "picture" else "theme",
                "v": hashlib.sha1(f"{f}:{st.st_mtime}:{st.st_size}".encode()).hexdigest()[:12]}

