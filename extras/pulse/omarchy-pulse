# ---------------------------------------------------------------- HTTP (127.0.0.1 only)

def make_handler(hub: Hub, tok: str, port: int):
    hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}
    types = {".html": "text/html; charset=utf-8", ".js": "text/javascript; charset=utf-8",
             ".css": "text/css; charset=utf-8", ".svg": "image/svg+xml", ".ttf": "font/ttf", ".png": "image/png"}

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code: int, body: bytes, ctype: str = "application/json", cache: bool = False) -> None:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "max-age=3600" if cache else "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            self.wfile.write(body)

        def _ok(self) -> bool:
            if self.headers.get("Host") not in hosts:   # DNS rebinding: only our own address
                self._send(403, b'{"error":"host"}')
                return False
            return True

        def _authed(self, q: dict) -> bool:
            got = self.headers.get("X-Pulse-Token") or q.get("token", "")
            if not secrets.compare_digest(str(got), tok):
                self._send(401, b'{"error":"token"}')
                return False
            return True

        def do_GET(self):
            if not self._ok():
                return
            u = urllib.parse.urlsplit(self.path)
            q = dict(urllib.parse.parse_qsl(u.query))
            path = u.path
            if path.startswith("/scene/"):   # 1.5: a community scene, alone in its sandbox (no token inside)
                name = urllib.parse.unquote(path[7:])
                if not secrets.compare_digest(str(q.get("ticket", "")), scene_ticket(tok)):
                    self._send(401, b'{"error":"ticket"}')
                    return
                page = scene_page(name)
                if page is None:
                    self._send(404, b"{}")
                    return
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(page)))
                self.send_header("Content-Security-Policy", SCENE_CSP)
                self.send_header("Cache-Control", "no-store")
                self.send_header("X-Content-Type-Options", "nosniff")
                self.end_headers()
                self.wfile.write(page)
                return
            if path == "/api/cover":   # 1.6: the cover of the song that plays, for its colours
                if not self._authed(q):
                    return
                cv = hub.cover_bytes()
                if not cv:
                    self._send(404, b"{}")
                    return
                self.send_response(200)
                self.send_header("Content-Type", cv[1])
                self.send_header("Content-Length", str(len(cv[0])))
                self.send_header("Cache-Control", "private, max-age=86400")
                self.send_header("X-Content-Type-Options", "nosniff")
                self.end_headers()
                self.wfile.write(cv[0])
                return
            if path == "/api/wallpaper":   # 1.5.1: your own wallpaper, read from your disk (never from the network)
                if not self._authed(q):
                    return
                f = wallpaper_path(hub.conf("pulse", "wallpaper", default=""))
                if not f:
                    self._send(404, b"{}")
                    return
                data = f.read_bytes()
                self.send_response(200)
                self.send_header("Content-Type", WALL_TYPES[f.suffix.lower()])
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Cache-Control", "private, max-age=31536000")   # the URL changes when the picture does
                self.send_header("X-Content-Type-Options", "nosniff")
                self.end_headers()
                self.wfile.write(data)
                return
            if path == "/api/scene-design":   # 1.6: the scene editor opens a scene it made
                if not self._authed(q):
                    return
                f = scene_path(q.get("name", ""))
                if not f:
                    self._send(200, b"{}")
                    return
                d = design_of(f.read_text(encoding="utf-8", errors="replace"))
                self._send(200, json.dumps({"design": d, "path": str(f), "meta": scene_meta(q.get("name", ""))} if d else {"error": "handwritten", "path": str(f)}).encode())
                return
            if path == "/api/gallery":   # 1.7: the scenes people shared (the editor's Community tab)
                if not self._authed(q):
                    return
                try:
                    items = gallery_index()
                    mine = scene_list()
                    self._send(200, json.dumps({"base": GALLERY_RAW, "scenes": [{**x, "installed": x.get("name") in mine} for x in items]}).encode())
                except Exception as e:   # noqa: BLE001 - offline, GitHub down
                    self._send(200, json.dumps({"scenes": [], "error": f"the gallery is not reachable now ({type(e).__name__})"}).encode())
                return
            if path in ("/api/scenes", "/api/scene-src", "/api/scene-state"):   # the scene lab
                if not self._authed(q):
                    return
                if path == "/api/scenes":
                    body = {"scenes": scene_list(), "ticket": scene_ticket(tok), "builtin": list(BUILTIN_SCENES)}
                elif path == "/api/scene-src":
                    f = scene_path(q.get("name", ""))
                    src = f.read_text(encoding="utf-8", errors="replace") if f else ""
                    body = {"name": q.get("name", ""), "path": str(f or ""), "src": src,
                            "mtime": f.stat().st_mtime if f else 0, "checks": scene_check(src) if f else []}
                else:
                    with hub.lock:
                        body = hub.scene_state()
                self._send(200, json.dumps(body, separators=(",", ":")).encode())
                return
            if path == "/api/visibility":
                if self._authed(q):
                    with hub.lock:
                        data = {"mons": hub.mons,
                                "pause_when_covered": hub.conf("pulse", "pause_when_covered", default=True)}
                        body = json.dumps(data, separators=(",", ":")).encode()
                    self._send(200, body)
                return
            if path == "/api/live":   # music bars and effects, as they happen (server-sent events)
                if not self._authed(q):
                    return
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                last_fx = hub.fx_seq if q.get("fx", "-1") == "-1" else int(q.get("fx", "0") or 0)
                sent, cur = 0.0, None
                with hub.lock:
                    hub.live_clients += 1
                try:
                    while True:
                        now = time.time()
                        audio = hub.audio if now - hub.audio_t < 0.5 else None
                        with hub.lock:
                            fx = [f for f in hub.fx if f["seq"] > last_fx]
                        if fx:
                            last_fx = fx[-1]["seq"]
                        c = hub.cursor if hub.cursor != cur else None
                        if audio is not None or fx or c or now - sent > 2:
                            msg = {"a": audio, "fx": fx}
                            if c:
                                msg["c"] = cur = c
                            self.wfile.write(b"data: " + json.dumps(msg, separators=(",", ":")).encode() + b"\n\n")
                            self.wfile.flush()
                            sent = now
                        time.sleep(0.05 if audio is not None else 0.2)
                except OSError:
                    return
                finally:
                    with hub.lock:
                        hub.live_clients -= 1
            if path == "/api/perf":
                if self._authed(q):
                    with hub.lock:
                        self._send(200, json.dumps({"perf": hub.perf, "nvidia": nvidia(),
                                                    "dmabuf": not dmabuf_disabled(hub.conf("pulse", "dmabuf", default="auto"), nvidia())}).encode())
                return
            if path == "/api/state":
                if self._authed(q):
                    self._send(200, json.dumps(hub.state(), separators=(",", ":")).encode())
                return
            if path.startswith("/img/"):
                if not self._authed(q):
                    return
                if hub.privacy():
                    self._send(204, b"")
                    return
                img = hub.images.get(urllib.parse.unquote(path[5:]))
                if not img:
                    self._send(404, b"{}")
                    return
                self._send(200, img[0], img[1])
                return
            name = "index.html" if path in ("/", "") else path.lstrip("/")
            f = (WEB / name).resolve()
            if WEB.resolve() not in f.parents or not f.is_file():
                self._send(404, b"{}")
                return
            self._send(200, f.read_bytes(), types.get(f.suffix, "application/octet-stream"), cache=f.suffix == ".ttf")

        def do_POST(self):
            if not self._ok():
                return
            u = urllib.parse.urlsplit(self.path)
            q = dict(urllib.parse.parse_qsl(u.query))
            if not self._authed(q):
                return
            n = int(self.headers.get("Content-Length") or 0)
            if n < 0 or n > 8_000_000:
                self._send(413, b"{}")
                return
            body = self.rfile.read(n)
            if u.path == "/api/trap":   # 1.5 beta: snmptrapd's traphandle (omarchy-pulse trap)
                hub.bolt(trap_parse(body.decode("utf-8", "replace")[:4000]))
                self._send(204, b"")
                return
            if u.path == "/api/term":   # 1.5 beta: what you type in omarchy-pulse term, shown on the wallpaper
                try:
                    tj = json.loads(body or b"{}")
                except ValueError:
                    tj = {}
                lines = tj.get("lines", []) if isinstance(tj, dict) else []
                with hub.lock:
                    if isinstance(tj, dict) and tj.get("clear"):
                        hub.term.clear()
                    for ln in lines[:20]:
                        hub.term.append({"t": time.time(), "text": str(ln)[:100]})
