                self._send(200, json.dumps({"on": hub.noc_on(), "incident": bool(hub.incident)}).encode())
                return
            if u.path.startswith("/api/ack/"):   # 1.5: acknowledge a problem on its own system (a source with ack = "...")
                self._send(200, json.dumps(hub.ack(urllib.parse.unquote(u.path[9:]))).encode())
                return
            if u.path == "/api/scene-design":   # 1.6: the scene editor saves (only into your scenes folder)
                try:
                    res = design_save(q.get("name", ""), json.loads(body or b"{}"))
                except ValueError as e:
                    res = {"error": str(e), "code": 400}
                self._send(res.pop("code", 200), json.dumps(res).encode())
