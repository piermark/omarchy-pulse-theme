def make_recap(last_day: str, conf: dict) -> Path | None:
    """1.6: the week in a minute: a moment of each day's video (the diary), then the numbers of the week."""
    if not shutil.which("ffmpeg"):
        return None
    end = time.mktime(time.strptime(last_day, "%Y-%m-%d")) + 43200
    days = [time.strftime("%Y-%m-%d", time.localtime(end - (6 - i) * 86400)) for i in range(7)]
    vids = [diary_path(d, conf) for d in days if diary_path(d, conf).exists()]
    if not vids:
        return None
    work = STATE_DIR / "recap"
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(parents=True, exist_ok=True)
    font = ""
    if shutil.which("fc-match"):
        font = subprocess.run(["fc-match", "-f", "%{file}", "monospace:bold"], capture_output=True, text=True).stdout.strip()
    year, week = time.strftime("%G", time.localtime(end)), time.strftime("%V", time.localtime(end))   # the ISO week
    parts = [text_clip(work, 0, f"WEEK {int(week)} · {year}\nOMARCHY PULSE", font, 2.2)]
    enc = ["-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p", "-r", "30"]
    for k, f in enumerate(vids):
        out = work / f"day{k}.mp4"
        mid = 6.0
        if shutil.which("ffprobe"):
            pr = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(f)],
                                capture_output=True, text=True, timeout=30)
            try:
                mid = max(0.0, float(pr.stdout.strip()) / 2 - 1.5)
            except ValueError:
                pass
        r = subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", f"{mid:.2f}", "-i", str(f), "-t", "3",
                            "-vf", "scale=1280:720:force_original_aspect_ratio=decrease,pad=1280:720:(ow-iw)/2:(oh-ih)/2", "-an",
                            *enc, str(out)], capture_output=True, timeout=120)
        if r.returncode == 0 and out.exists() and out.stat().st_size > 0:
            parts.append(out)
    total: dict = {}
    allst = day_stats()
    for d in days:
        for k, v in (allst.get(d) or {}).items():
            total[k] = total.get(k, 0) + v
    lines = day_card("", total)[1:]
    parts.append(text_clip(work, 1, "\n".join(lines) if lines else "see you next week", font, 3.2))
    parts = [p for p in parts if p]
    if len(parts) < 2:
        return None
    lst = work / "list.txt"
