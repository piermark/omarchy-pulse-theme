# -- backups
def backup_state(name: str, kind: str, data, max_age: float, now: float) -> dict:
    """One backup job: running, ok, failed or late (its last good run older than max_age)."""
    st, t = "unknown", None
    if kind == "restic":
        snaps = data if isinstance(data, list) else []
        ts = [iso_time(s.get("time", "")) for s in snaps]
        t = max([x for x in ts if x] or [0]) or None
        st = "ok" if t else "failed"
    elif kind == "pbs":
        snaps = (data or {}).get("data", []) if isinstance(data, dict) else []
        t = max([float(s.get("backup-time") or 0) for s in snaps] or [0]) or None
        st = "ok" if t else "failed"
    elif kind == "veeam":
        j = data if isinstance(data, dict) else {}
        st = {"success": "ok", "warning": "ok", "failed": "failed"}.get(str(j.get("lastResult", "")).lower(), "unknown")
        if str(j.get("status", "")).lower() == "running":
            st = "running"
        t = iso_time(j.get("lastRun", ""))
    elif kind == "command":
        j = data if isinstance(data, dict) else {}
        st = str(j.get("state") or "unknown")
        t = float(j["t"]) if j.get("t") else None
    if st == "ok" and t and now - t > max_age:
        st = "late"
    return {"name": name[:24], "state": st, "t": t}


def iso_time(v: str) -> float | None:
    import calendar
    m = re.match(r"(\d{4})-(\d\d)-(\d\d)[T ](\d\d):(\d\d):(\d\d)(?:\.\d+)?(Z|[+-]\d\d:?\d\d)?", str(v or ""))
    if not m:
        return None
    y, mo, d, h, mi, s, tz = m.groups()
    t = calendar.timegm((int(y), int(mo), int(d), int(h), int(mi), int(s)))
    if tz and tz != "Z":
        sign, tz = (1 if tz[0] == "+" else -1), tz[1:].replace(":", "")
        t -= sign * (int(tz[:2]) * 3600 + int(tz[2:]) * 60)
    return float(t)


# -- intruders
def crowdsec_alerts(rows: list) -> list:
    out = []
    for a in rows or []:
        src = a.get("source") or {}
        out.append({"level": "crit" if a.get("decisions") else "warn", "target": str(a.get("machine_id") or "server")[:24],
                    "what": str(a.get("scenario") or "")[:48], "country": src.get("cn", ""), "t": iso_time(a.get("created_at", "")) or time.time()})
    return out


def wazuh_alerts(j: dict, min_level: int = 10) -> list:
    out = []
    for h in ((j or {}).get("hits") or {}).get("hits", []) or []:
        s = h.get("_source") or {}
        lv = int((s.get("rule") or {}).get("level") or 0)
        if lv < min_level:
            continue
        out.append({"level": "crit" if lv >= 12 else "warn", "target": str((s.get("agent") or {}).get("name") or "server")[:24],
                    "what": str((s.get("rule") or {}).get("description") or "")[:48], "lv": lv, "t": iso_time(s.get("timestamp", "")) or time.time()})
    return out


def parse_age(v) -> float:
    """90s, 15m, 26h, 2d (or seconds) as seconds."""
    m = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([smhd]?)\s*", str(v))
    return float(m.group(1)) * {"s": 1, "": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)] if m else 26 * 3600.0


# ---------------------------------------------------------------------------- 1.5: what expires (certificates, domains)
def tls_expiry(host: str, port: int = 443, timeout: float = 8) -> dict:
    """When the TLS certificate of host:port expires (epoch), and whether it is valid now. No credentials needed."""
    import ssl
    ctx = ssl.create_default_context()
    try:
        with socket.create_connection((host, port), timeout=timeout) as sock:
            with ctx.wrap_socket(sock, server_hostname=host) as ss:
                cert = ss.getpeercert()
        return {"at": ssl.cert_time_to_seconds(cert["notAfter"]), "valid": True}
    except ssl.SSLCertVerificationError as e:   # expired, self-signed...: still read its date
        ctx = ssl.create_default_context()
        ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE
        with socket.create_connection((host, port), timeout=timeout) as sock:
            with ctx.wrap_socket(sock, server_hostname=host) as ss:
                der = ss.getpeercert(binary_form=True)
        at = der_not_after(der)
        return {"at": at, "valid": False, "why": str(getattr(e, "verify_message", "") or e)[:80]}


def der_not_after(der: bytes) -> float | None:
    """The notAfter date of a DER certificate, without any library: the second time in its validity."""
    import calendar
    times = re.findall(rb"\x17\x0d(\d{12})Z|\x18\x0f(\d{14})Z", der[:1500])
    if len(times) < 2:
        return None
    utc, gen = times[1]
    v = (utc or gen).decode()
    if utc:
        v = ("19" if int(v[:2]) >= 50 else "20") + v
    return float(calendar.timegm(time.strptime(v, "%Y%m%d%H%M%S")))


def whois_expiry(domain: str) -> float | None:
    """When a domain expires, from `whois` (any TLD that publishes it)."""
    import calendar
    if not shutil.which("whois") or not re.match(r"^[a-z0-9.-]+\.[a-z]{2,}$", domain.lower()):
        return None
    try:
        out = subprocess.run(["whois", domain], capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    return whois_date(out)


def whois_date(out: str) -> float | None:
    import calendar
    m = re.search(r"(?im)^\s*(?:registry expiry date|registrar registration expiration date|expir\w*(?: date)?|expires(?: on)?|paid-till|renewal date)\s*:\s*(.+)$", out)
    if not m:
        return None
    v = m.group(1).strip()
    for cand, fmt in ((v[:19], "%Y-%m-%dT%H:%M:%S"), (v[:19], "%Y-%m-%d %H:%M:%S"), (v[:10], "%Y-%m-%d"), (v[:11], "%d-%b-%Y"),
                      (v[:10], "%Y.%m.%d"), (v[:10], "%d/%m/%Y"), (v[:10], "%Y/%m/%d"), (v[:10], "%d.%m.%Y")):
        try:
            return float(calendar.timegm(time.strptime(cand, fmt)))
        except ValueError:
            continue
    return None


def expiry_view(items: list, now: float, warn: int = 14, crit: int = 3) -> list:
    out = []
    for it in items:
        if it.get("at") is None:
            out.append({**it, "days": None, "level": "warn"})
            continue
        days = (it["at"] - now) / 86400
        lv = "crit" if days <= crit or it.get("valid") is False else "warn" if days <= warn else "ok"
        out.append({**it, "days": round(days, 1), "level": lv})
    return sorted(out, key=lambda x: (x["days"] is not None, x["days"] if x["days"] is not None else 0))


def power_w(v, unit: str = "") -> float | None:
    """A Home Assistant power state in watts (W or kW)."""
    try:
        x = float(v)
    except (TypeError, ValueError):
        return None
    return x * 1000 if str(unit).lower() == "kw" else x


# ---------------------------------------------------------------------------- 1.5: community scenes
SCENE_NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")
BUILTIN_SCENES = ("sphere", "skyline", "orbit", "calm", "hacker", "noir")
USER_SCENES = CONF_DIR / "scenes"
SCENE_MAX = 4 * 1024 * 1024   # 1.7: room for the pictures a scene carries (data: URLs)
# a scene runs alone: no network, no forms, no popups, no way out of its frame
SCENE_CSP = ("default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; "
             "media-src data: blob:; sandbox allow-scripts")


def scene_path(name: str):
    """A community scene: yours (~/.config/omarchy-pulse/scenes/NAME.js) first, then the ones that come with Pulse."""
    if not SCENE_NAME.match(str(name or "")) or name in BUILTIN_SCENES:
        return None
    for d in (USER_SCENES, WEB / "scenes"):
        f = d / f"{name}.js"
        if f.is_file() and f.stat().st_size <= SCENE_MAX:
            return f
    return None


def scene_list() -> dict:
    out = {}
    for where, d in (("pulse", WEB / "scenes"), ("yours", USER_SCENES)):
        if d.is_dir():
            for f in sorted(d.glob("*.js")):
                if SCENE_NAME.match(f.stem) and f.stem not in BUILTIN_SCENES:
                    out[f.stem] = where
    return out


def scene_ticket(tok: str) -> str:
    """What the scene frame is loaded with: never the token itself, only a key that opens the scenes."""
    return hmac.new(tok.encode(), b"omarchy-pulse scene", hashlib.sha256).hexdigest()[:32]


def scene_page(name: str) -> bytes | None:
    f = scene_path(name)
    if not f:
        return None
    safe = lambda x: x.replace("</script", "<\\/script")   # noqa: E731
    rt = (WEB / "scene-runtime.js").read_text(encoding="utf-8")
    src = f.read_text(encoding="utf-8", errors="replace")
    return ('<!doctype html><html><head><meta charset="utf-8"><style>html,body{margin:0;height:100%;background:transparent;'
            'overflow:hidden}canvas{position:fixed;inset:0;width:100%;height:100%;display:block}</style></head><body>'
            f'<canvas id="c"></canvas><script>{safe(rt)}</script><script>{safe(src)}</script></body></html>').encode()


DESIGN_RE = re.compile(r"/\*DESIGN\*/(.*?)/\*END\*/", re.S)


ASSET_ID = re.compile(r"^[A-Za-z0-9_-]{1,32}$")
ASSET_URL = re.compile(r"^data:image/(png|jpeg|webp|svg\+xml);base64,([A-Za-z0-9+/=]+)$")
ASSET_MAX = 2 * 1024 * 1024        # one picture, decoded
ASSETS_MAX = 3 * 1024 * 1024       # all the pictures of a design, as written
SVG_BAD = re.compile(r"<\s*script|<\s*foreignObject|\bon[a-z]+\s*=|javascript:|(?:href|src)\s*=\s*[\"']?\s*(?:https?:|//|file:)", re.I)
PALETTE_KEYS = ("bg", "fg", "accent", "accent2", "ok", "warn", "crit", "dim")


def asset_clean(url) -> str:
    """1.7: a picture in a design: a data: URL of a PNG, JPEG, WebP or SVG (an SVG with no scripts and no links out)."""
    m = ASSET_URL.match(url if isinstance(url, str) else "")
    if not m:
        raise ValueError("a picture must be a PNG, JPEG, WebP or SVG data: URL")
    try:
        raw = base64.b64decode(m.group(2), validate=True)
    except ValueError:
        raise ValueError("a picture is not valid base64") from None
    if len(raw) > ASSET_MAX:
        raise ValueError(f"a picture is bigger than {ASSET_MAX // (1024 * 1024)} MB")
    magic = {"png": raw[:8] == b"\x89PNG\r\n\x1a\n", "jpeg": raw[:3] == b"\xff\xd8\xff",
             "webp": raw[:4] == b"RIFF" and raw[8:12] == b"WEBP", "svg+xml": b"<svg" in raw[:4096].lower()}
    if not magic[m.group(1)]:
        raise ValueError("a picture is not what it says it is")
    if m.group(1) == "svg+xml" and SVG_BAD.search(raw.decode("utf-8", "replace")):
        raise ValueError("an SVG with scripts, events or links out")
    return url


def _num01(v, d):
    try:
        return max(0.0, min(1.0, float(v)))
    except (TypeError, ValueError):
        return d


def design_clean(d) -> dict:
    """A design from the scene editor, checked: plain data only (it is drawn by scene-design.js, never run).
    1.7: pictures (assets), a background, a palette of its own and actions; nothing in it is ever run."""
    if not isinstance(d, dict) or not isinstance(d.get("shapes", []), list) or len(d.get("shapes", [])) > 200:
        raise ValueError("not a design")
    out = {"v": 2, "sky": str(d.get("sky") or "none")[:16], "city": bool(d.get("city")),
           "shapes": [x for x in d.get("shapes", []) if isinstance(x, dict)]}
    assets = d.get("assets") or {}
    if not isinstance(assets, dict) or len(assets) > 40:
        raise ValueError("at most 40 pictures")
    out["assets"] = {}
    for k, v in assets.items():
        if not ASSET_ID.match(str(k)):
            raise ValueError("a picture's name: letters, digits, - and _")
        out["assets"][str(k)] = asset_clean(v)
    if sum(len(v) for v in out["assets"].values()) > ASSETS_MAX:
        raise ValueError(f"the pictures are more than {ASSETS_MAX // (1024 * 1024)} MB together")
    bg = d.get("background")
    if isinstance(bg, dict) and bg.get("asset") in out["assets"]:
        out["background"] = {"asset": bg["asset"], "fit": "contain" if bg.get("fit") == "contain" else "cover",
                             "alpha": _num01(bg.get("alpha", 1), 1.0), "dim": _num01(bg.get("dim", 0), 0.0), "y": _num01(bg.get("y", 0.5), 0.5)}
    pal = d.get("palette")
    if isinstance(pal, dict):
        out["palette"] = {k: v for k, v in pal.items() if k in PALETTE_KEYS and isinstance(v, str) and re.match(r"^#[0-9a-fA-F]{6}$", v)}
    acts = d.get("actions") or []
    if not isinstance(acts, list) or len(acts) > 40:
        raise ValueError("at most 40 actions")
    out["actions"] = [a for a in acts if isinstance(a, dict) and isinstance(a.get("when"), dict) and isinstance(a.get("do"), list)][:40]
    if len(json.dumps({k: v for k, v in out.items() if k != "assets"})) > 300_000:
        raise ValueError("the design is too big")
    return out


def design_scene(name: str, design: dict) -> str:
    """The scene file the editor saves: the design as data, then the engine that draws it. One file, like every scene."""
    data = json.dumps(design_clean(design), indent=1, ensure_ascii=True).replace("/", "\\/")   # no */ or </script inside
    engine = (WEB / "scene-design.js").read_text(encoding="utf-8")
    return (f"// {name}: a scene made with the Pulse scene editor (omarchy-pulse scene editor {name}). MIT.\n"
            "// The DESIGN below is plain data: open it in the editor to change it. The code after it draws it.\n"
            f"var DESIGN = /*DESIGN*/{data}/*END*/;\n{engine}\nPulseScene.register({json.dumps(name)}, PulseDesign.scene(DESIGN));\n")


def design_of(src: str):
    """The design inside a scene the editor saved, or None for a scene written by hand."""
    m = DESIGN_RE.search(src or "")
    if not m:
        return None
    try:
        return design_clean(json.loads(m.group(1)))
    except ValueError:
        return None


def scene_check(src: str) -> list:
    """What a scene needs to be shared: the checks of `omarchy-pulse scene check` and of the scene lab."""
    out = []
    if "PulseScene.register(" not in src:
        out.append(("crit", "it never calls PulseScene.register(name, {...})"))
    if len(src.encode()) > SCENE_MAX:
        out.append(("crit", f"bigger than {SCENE_MAX // 1024} KB"))
    for pat, what in ((r"\bfetch\s*\(|XMLHttpRequest|WebSocket|EventSource|navigator\.sendBeacon", "network calls (they are blocked)"),
                      (r"\bimport\s*\(|importScripts", "imports (a scene is one file)"),
                      (r"localStorage|sessionStorage|indexedDB|document\.cookie", "storage (a scene keeps its state in memory)"),
                      (r"\beval\s*\(|new\s+Function\s*\(", "eval")):
        if re.search(pat, src):
            out.append(("warn", what))
    if not re.search(r"\.motion\b|reduced", src):
        out.append(("warn", "it never looks at state.ui.motion: with motion = \"reduced\" it should keep still"))
    if not out:
        out.append(("ok", "ready to share"))
    return out


# ---------------------------------------------------------------------------- 1.7: packages (.pulse files)
# A package is what people share: one JSON file with a scene (made in the editor, or written by hand), its pictures, its
# actions, a preview and who made it under which licence. Importing one is safe: a scene runs in its sandbox (no network,
# no token, no files) and its actions only ask Pulse for its own effects. What could run on your computer (commands,
# [[source]] scripts) is never part of a package: they are shared as pull requests, reviewed by a person.
# ---- 1.8: "describe your world": an AI agent writes the design (data, checked like any other); Pulse only reads it
DESIGN_TYPES = ("rect", "ellipse", "line", "star", "text", "ring", "bars", "tower", "wave", "particles", "image")
DESIGN_SRC = ("cpu", "ram", "gpu", "temp", "disk", "net", "hour", "minute", "second", "weekday", "outside", "rain", "wind", "cloud",
              "daylight", "sun", "moon", "planes", "iss", "starlink", "kp", "launch", "agents", "working", "waiting", "failed",
              "commits", "cifail", "music", "focus", "meeting", "away", "item")
DESIGN_PROPS = ("x", "y", "w", "h", "alpha", "rot", "glow", "heat", "speed", "level", "count", "amp")
DESIGN_EVENTS = ("agent-waiting", "agent-done", "agent-failed", "agent-new", "ci-fail", "ci-ok", "commit", "hour", "plane", "iss",
                 "launch", "rain", "focus", "back", "music", "row-crit", "row-ok", "click", "start", "every")
DESIGN_FX = ("fireworks", "banner", "lightning", "shooting", "tip", "launch", "flare", "chime", "text")
DESIGN_COLORS = ("bg", "fg", "accent", "accent2", "ok", "warn", "crit", "dim")


def design_from_text(txt: str) -> dict:
    """The design in an agent's reply: the JSON object, with or without words and code fences around it."""
    txt = str(txt or "")
    m = re.search(r"```(?:json)?\s*(\{.*\})\s*```", txt, re.S)
    cand = [m.group(1)] if m else []
    i, j = txt.find("{"), txt.rfind("}")
    if 0 <= i < j:
        cand.append(txt[i:j + 1])
    for c in cand:
        try:
            d = json.loads(c)
        except ValueError:
            continue
        if isinstance(d, dict) and isinstance(d.get("design"), dict):   # a whole package, or {"design": ...}
            d = d["design"]
        if isinstance(d, dict) and isinstance(d.get("shapes"), list):
            return d
    raise ValueError("no design in the reply: it must be one JSON object with a \"shapes\" list")


def design_fix(d: dict) -> tuple[dict, list]:
    """A design written by hand or by an agent, made safe to draw: what the engine does not know is dropped or set to a
    default, and said. Returns (design, notes). Never raises for a detail; design_clean still has the last word."""
    notes, shapes, ids = [], [], set()
    num = lambda v, lo, hi, dv: max(lo, min(hi, float(v))) if isinstance(v, (int, float)) and not isinstance(v, bool) else dv   # noqa: E731
    for n, sh in enumerate((d.get("shapes") or [])[:200]):
        if not isinstance(sh, dict) or sh.get("type") not in DESIGN_TYPES:
            notes.append(f"shape {n + 1}: unknown type {str((sh or {}).get('type') if isinstance(sh, dict) else sh)[:20]!r}, dropped")
            continue
        sh = dict(sh)
        sid = re.sub(r"[^A-Za-z0-9_-]", "-", str(sh.get("id") or f"s{n + 1}"))[:32] or f"s{n + 1}"
        while sid in ids:
            sid += "x"
        ids.add(sid)
        sh["id"] = sid
        sh["name"] = str(sh.get("name") or sh["type"])[:60]
        sh["x"], sh["y"] = num(sh.get("x"), -0.2, 1.2, 0.5), num(sh.get("y"), -0.2, 1.2, 0.6)
        sh["w"], sh["h"] = num(sh.get("w"), 0, 1.5, 0.1), num(sh.get("h"), 0, 1.5, 0.1)
        sh["alpha"], sh["glow"] = num(sh.get("alpha"), 0, 1, 1), num(sh.get("glow"), 0, 3, 0)
        for ck in ("color", "color2"):
            if ck in sh and sh[ck] not in DESIGN_COLORS:
                notes.append(f"{sid}: colour {str(sh[ck])[:16]!r} is not a theme colour, using accent")
                sh[ck] = "accent"
        sh.setdefault("color", "accent")
        an = sh.get("anim") if isinstance(sh.get("anim"), dict) else {}
        sh["anim"] = {"kind": an.get("kind") if an.get("kind") in ("none", "pulse", "spin", "bob", "sway", "blink", "breathe", "drift") else "none",
                      "speed": num(an.get("speed"), 0, 10, 1)}
        binds = []
        for b in (sh.get("bind") or [])[:8] if isinstance(sh.get("bind"), list) else []:
            src = str((b or {}).get("src") or "") if isinstance(b, dict) else ""
            if isinstance(b, dict) and b.get("prop") in DESIGN_PROPS and (src in DESIGN_SRC or re.match(r"^panel:[A-Za-z0-9_.-]{1,40}$", src)) \
                    and all(isinstance(b.get(k), (int, float)) for k in ("from", "to")):
                binds.append({k: b[k] for k in ("prop", "src", "from", "to", "lo", "hi") if k in b and (k in ("prop", "src") or isinstance(b[k], (int, float)))})
            else:
                notes.append(f"{sid}: a binding it cannot follow ({str(b)[:50]}), dropped")
        sh["bind"] = binds
        rp = sh.get("repeat") if isinstance(sh.get("repeat"), dict) else {}
        if rp.get("by") not in ("none", "agents", "repos", "cores", "planes", "panel", "count", None):
            notes.append(f"{sid}: it cannot repeat by {str(rp.get('by'))[:16]!r}, one copy")
            rp = {}
        sh["repeat"] = {**rp, "by": rp.get("by") or "none"}
        for tk in ("text", "click"):
            if tk in sh:
                sh[tk] = str(sh[tk])[:120]
        if sh["type"] == "image" and str(sh.get("asset")) not in (d.get("assets") or {}):
            notes.append(f"{sid}: its picture {str(sh.get('asset'))[:20]!r} is not in assets, dropped")
            ids.discard(sid)
            continue
        ks = sh.get("keys")
        if ks is not None:
            fr = [{k: f[k] for k in ("t", "dx", "dy", "scale", "alpha", "rot") if isinstance(f.get(k), (int, float))}
                  for f in (ks.get("frames") or [])[:24] if isinstance(f, dict)] if isinstance(ks, dict) else []
            if len(fr) >= 2:
                sh["keys"] = {"start": "action" if ks.get("start") == "action" else "loop", "loop": bool(ks.get("loop", ks.get("start") != "action")),
                              "dur": num(ks.get("dur"), 0.2, 60, 2), "ease": "linear" if ks.get("ease") == "linear" else "smooth", "frames": fr}
            else:
                sh.pop("keys", None)
        shapes.append(sh)
    acts = []
    for n, a in enumerate((d.get("actions") or [])[:40] if isinstance(d.get("actions"), list) else []):
        w, do = (a.get("when"), a.get("do")) if isinstance(a, dict) else (None, None)
        ok = isinstance(w, dict) and isinstance(do, list) and (
            w.get("type") == "event" and w.get("event") in DESIGN_EVENTS or
            w.get("type") in ("above", "below") and isinstance(w.get("value"), (int, float)) and
            (w.get("src") in DESIGN_SRC or re.match(r"^panel:[A-Za-z0-9_.-]{1,40}$", str(w.get("src") or ""))))
        dos = []
        for x in (do or [])[:8] if ok else []:
            if isinstance(x, dict) and x.get("type") == "fx" and x.get("fx") in DESIGN_FX:
                dos.append({"type": "fx", "fx": x["fx"], "text": str(x.get("text") or "")[:60]})
            elif isinstance(x, dict) and x.get("type") in ("play", "flash", "show", "hide", "toggle") and str(x.get("shape")) in ids:
                e = {"type": x["type"], "shape": str(x["shape"])}
                if x["type"] == "flash":
                    e["color"] = x.get("color") if x.get("color") in DESIGN_COLORS else "warn"
                    e["secs"] = num(x.get("secs"), 0.3, 30, 3)
                dos.append(e)
        if not ok or not dos:
            notes.append(f"action {n + 1}: nothing Pulse can do with it, dropped")
            continue
        if w.get("event") == "click" and w.get("shape") and str(w["shape"]) not in ids:
            w = {k: v for k, v in w.items() if k != "shape"}
        if w.get("event") == "every":
            w = {**w, "secs": num(w.get("secs"), 5, 86400, 60)}
        acts.append({"id": re.sub(r"[^A-Za-z0-9_-]", "", str(a.get("id") or f"a{n + 1}"))[:16] or f"a{n + 1}", "when": w, "do": dos,
                     "cooldown": num(a.get("cooldown"), 1, 3600, 10)})
    out = {"v": 2, "sky": d.get("sky") if d.get("sky") in DESIGN_COLORS else "none", "city": bool(d.get("city")), "shapes": shapes,
           "assets": d.get("assets") if isinstance(d.get("assets"), dict) else {}, "actions": acts}
    for k in ("background", "palette"):
        if isinstance(d.get(k), dict):
            out[k] = d[k]
    if not shapes:
        raise ValueError("no shape Pulse can draw in it")
    return out, notes


def design_save(name: str, design: dict) -> dict:
    """Writes a design as one of YOUR scenes (never over a scene that comes with Pulse or one written by hand)."""
    if not SCENE_NAME.match(name or "") or name in BUILTIN_SCENES:
        return {"error": "a name: a-z, 0-9 and -, not a built-in scene", "code": 400}
    f = USER_SCENES / f"{name}.js"
    if (WEB / "scenes" / f"{name}.js").exists() and not f.exists():
        return {"error": "a scene that comes with Pulse has this name: choose another", "code": 409}
    if f.exists() and design_of(f.read_text(encoding="utf-8", errors="replace")) is None:
        return {"error": "a scene written by hand has this name: choose another", "code": 409}
    try:
        src = design_scene(name, design)
    except (ValueError, TypeError) as e:
        return {"error": str(e), "code": 400}
    if len(src.encode()) > SCENE_MAX:
        return {"error": "too big", "code": 400}
    USER_SCENES.mkdir(parents=True, exist_ok=True)
    tmp = f.with_suffix(".js.tmp")
    tmp.write_text(src, encoding="utf-8")
    tmp.replace(f)
    return {"path": "~/" + str(f.relative_to(HOME)) if HOME in f.parents else str(f), "checks": scene_check(src)}


def scene_guide() -> str:
    try:
        return (WEB / "scene-guide.md").read_text(encoding="utf-8")
    except OSError:
        return ""


def describe_prompt(text: str, panels: dict | None = None) -> str:
    """The whole request for an agent: the guide, the user's panels (ids, units, row names: no values), what they asked."""
    lines = []
    for pid, p in sorted((panels or {}).items())[:40]:
        if "rows" in p:
            names = ", ".join(r.get("name") or "?" for r in p["rows"][:8])
            lines.append(f"- `{pid}`: a list with {len(p['rows'])} rows ({names}...): repeat by panel")
        else:
            rng = f", from {p['min']} to {p['max']}" if "min" in p else ""
            lines.append(f"- `panel:{pid}`: a number{' in ' + p['unit'] if p.get('unit') else ''}{rng}")
    return (scene_guide().rstrip() + "\n\n## The user's own panels\n\n" + ("\n".join(lines) if lines else "(none: use Pulse's own data)") +
            "\n\n## The request\n\nMake this scene. Reply with the JSON design only.\n\n> " + " ".join(str(text or "").split())[:1200] + "\n")


def describe_run(text: str, panels: dict | None, cmd: str) -> tuple[dict, list]:
    """Runs YOUR agent ([creator] agent = "claude -p", your own command, like a [[source]]) with the request on its
    standard input and reads the design from what it prints. Up to 3 minutes."""
    try:
        r = subprocess.run(shlex.split(cmd), input=describe_prompt(text, panels), capture_output=True, text=True, timeout=180)
    except (OSError, ValueError) as e:
        raise ValueError(f"your agent did not start ({cmd.split()[0] if cmd.split() else cmd}: {e})") from None
    except subprocess.TimeoutExpired:
        raise ValueError("your agent took more than 3 minutes") from None
    if r.returncode != 0 and not r.stdout.strip():
        raise ValueError("your agent failed: " + (r.stderr.strip().splitlines() or ["no output"])[-1][:200])
    d, notes = design_fix(design_from_text(r.stdout))
    return design_clean(d), notes


PKG_FORMAT = "omarchy-pulse-scene"
PKG_MAX = 6 * 1024 * 1024
PKG_LICENSES = ("MIT", "CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0")
PKG_KEYS = {"format", "v", "name", "title", "author", "license", "description", "pulse", "kind", "design", "js", "preview", "tags", "created"}
PKG_TAG = re.compile(r"^[a-z0-9][a-z0-9-]{0,23}$")
GALLERY_RAW = os.environ.get("PULSE_GALLERY", "https://raw.githubusercontent.com/piermark/omarchy-pulse-theme/main/community/scenes")


def _txt(v, n: int) -> str:
    return re.sub(r"[\x00-\x1f\x7f]", " ", str(v or "")).strip()[:n]


def package_check(pkg) -> tuple[list, dict | None]:
    """Is this a package Pulse can install? ([(level, message)...], the cleaned package or None)."""
    out = []
    if not isinstance(pkg, dict) or pkg.get("format") != PKG_FORMAT:
        return [("crit", "not a Pulse scene package (.pulse)")], None
    extra = sorted(set(pkg) - PKG_KEYS)
    if extra:   # commands, sources, scripts... have no place in a package
        out.append(("crit", "not allowed in a package: " + ", ".join(extra[:6])))
    name = str(pkg.get("name") or "")
    if not SCENE_NAME.match(name) or name in BUILTIN_SCENES:
        out.append(("crit", "a name: a-z, 0-9 and -, up to 32, not a built-in scene"))
    title, author = _txt(pkg.get("title") or name, 60), _txt(pkg.get("author"), 60)
    if not author:
        out.append(("crit", "who made it: author"))
    lic = str(pkg.get("license") or "")
    if lic not in PKG_LICENSES:
        out.append(("crit", "a licence that lets others use it: " + ", ".join(PKG_LICENSES)))
    kind = "js" if pkg.get("js") else "design"
    clean = {"format": PKG_FORMAT, "v": 1, "name": name, "title": title, "author": author, "license": lic,
             "description": _txt(pkg.get("description"), 400), "pulse": _txt(pkg.get("pulse") or VERSION, 16), "kind": kind,
             "tags": [t for t in (pkg.get("tags") or []) if isinstance(t, str) and PKG_TAG.match(t)][:6] if isinstance(pkg.get("tags"), list) else [],
             "created": _txt(pkg.get("created"), 32)}
    if kind == "design":
        try:
            clean["design"] = design_clean(pkg.get("design"))
        except (ValueError, TypeError) as e:
            out.append(("crit", "the scene: " + str(e)))
    else:
        src = pkg.get("js")
        if not isinstance(src, str):
            out.append(("crit", "the scene's code is not text"))
        else:
            res = scene_check(src)
            out += [r for r in res if r[0] != "ok"]
            clean["js"] = src
            out.append(("info", "a scene written in code: it runs in Pulse's sandbox, no network and no files"))
    pv = pkg.get("preview")
    if pv:
        try:
            if not str(pv).startswith("data:image/png;") and not str(pv).startswith("data:image/webp;") and not str(pv).startswith("data:image/jpeg;"):
                raise ValueError("x")
            clean["preview"] = asset_clean(pv)
        except ValueError:
            out.append(("warn", "the preview is not a picture: left out"))
    else:
        out.append(("warn", "no preview picture"))
    if len(json.dumps(clean)) > PKG_MAX:
        out.append(("crit", f"bigger than {PKG_MAX // (1024 * 1024)} MB"))
    if not any(lv == "crit" for lv, _ in out):
        out.append(("ok", "ready to install and to share"))
    return out, (None if any(lv == "crit" for lv, _ in out) else clean)


def package_src(clean: dict, name: str) -> str:
    """The scene file a package becomes, with who made it on top."""
    head = (f"// {name}: {clean['title']}, by {clean['author']} ({clean['license']}). Installed from a Pulse package.\n")
    if clean["kind"] == "design":
        return head + design_scene(name, clean["design"])
    js = clean["js"]
    m = re.search(r"PulseScene\.register\(\s*([\"'])([a-z0-9-]+)\1", js)
    if m and m.group(2) != name:   # installed under another name: the scene registers with that one
        js = js[:m.start(2)] + name + js[m.end(2):]
    return head + js


def package_install(pkg, name: str = "", force: bool = False) -> dict:
    """Install a package into your scenes; {path, name, checks} or {error}."""
    checks, clean = package_check(pkg)
    if not clean:
        return {"error": "; ".join(m for lv, m in checks if lv == "crit"), "checks": checks}
    name = name or clean["name"]
    if not SCENE_NAME.match(name) or name in BUILTIN_SCENES or (WEB / "scenes" / f"{name}.js").exists():
        return {"error": "choose another name: this one belongs to Pulse", "checks": checks}
    f = USER_SCENES / f"{name}.js"
    if f.exists() and not force:
        return {"error": "exists", "name": name, "checks": checks}
    src = package_src(clean, name)
    if len(src.encode()) > SCENE_MAX:
        return {"error": "too big", "checks": checks}
    USER_SCENES.mkdir(parents=True, exist_ok=True)
    tmp = f.with_suffix(".js.tmp")
    tmp.write_text(src, encoding="utf-8")
    tmp.replace(f)
    meta = {k: clean[k] for k in ("title", "author", "license", "description", "tags", "pulse", "created")}
    (USER_SCENES / f"{name}.meta.json").write_text(json.dumps(meta, indent=1), encoding="utf-8")
    shown = "~/" + str(f.relative_to(HOME)) if HOME in f.parents else str(f)
    return {"path": shown, "name": name, "checks": checks}


def scene_meta(name: str) -> dict:
    try:
        m = json.loads((USER_SCENES / f"{name}.meta.json").read_text(encoding="utf-8"))
        return m if isinstance(m, dict) else {}
    except (OSError, ValueError):
        return {}


def package_build(name: str, meta: dict | None = None, preview: str = "") -> dict:
    """A package of one of your scenes, to share: the design (or the code), the credits and a preview."""
    f = scene_path(name)
    if not f:
        raise ValueError(f"no scene called {name!r}")
    src = f.read_text(encoding="utf-8", errors="replace")
    m = {**scene_meta(name), **{k: v for k, v in (meta or {}).items() if v not in (None, "")}}
    pkg = {"format": PKG_FORMAT, "v": 1, "name": name, "title": m.get("title") or name, "author": m.get("author") or "",
           "license": m.get("license") or "MIT", "description": m.get("description") or "", "pulse": VERSION,
           "tags": m.get("tags") or [], "created": m.get("created") or time.strftime("%Y-%m-%d")}
    d = design_of(src)
    if d is not None:
        pkg["kind"], pkg["design"] = "design", d
    else:
        pkg["kind"], pkg["js"] = "js", re.sub(r"^// [^\n]*Installed from a Pulse package\.\n", "", src)
    if preview:
        pkg["preview"] = preview
    return pkg


_gallery = {"t": 0.0, "items": []}


def gallery_index(fetch=None) -> list:
    """The scenes people shared in community/scenes (index.json made by tools/scene-index.py), kept for 30 minutes."""
    if time.time() - _gallery["t"] < 1800 and _gallery["items"]:
        return _gallery["items"]
    j = (fetch or http_json)(GALLERY_RAW + "/index.json")
    items = [x for x in (j.get("scenes") if isinstance(j, dict) else []) or [] if isinstance(x, dict) and SCENE_NAME.match(str(x.get("name") or ""))]
    _gallery.update(t=time.time(), items=items[:500])
    return _gallery["items"]


def gallery_package(name: str, fetch=None, index=None) -> dict:
    """A package from the gallery, checked against the index (its size and sha256: what was reviewed is what you get)."""
    if not SCENE_NAME.match(name or ""):
        raise ValueError("a scene name")
    entry = next((x for x in (index if index is not None else gallery_index()) if x.get("name") == name), None)
    if not entry:
        raise ValueError(f"{name} is not in the gallery")
    url = f"{GALLERY_RAW}/{name}/{name}.pulse"
    if fetch:
        raw = fetch(url)
    else:
        req = urllib.request.Request(url, headers={"User-Agent": "omarchy-pulse/" + VERSION})
        with urllib.request.urlopen(req, timeout=20) as r:
            raw = r.read(PKG_MAX + 1)
    if len(raw) > PKG_MAX:
        raise ValueError("too big")
    if entry.get("sha256") and hashlib.sha256(raw).hexdigest() != entry["sha256"]:
        raise ValueError("it does not match the gallery's index: try again later")
    return json.loads(raw)


