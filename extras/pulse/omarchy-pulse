SHOWERS = [("Quadrantids", 1, 3, 1, 110, 230, 49), ("Lyrids", 4, 22, 2, 18, 271, 34), ("Eta Aquariids", 5, 6, 3, 50, 338, -1),
           ("Perseids", 8, 12, 3, 100, 48, 58), ("Draconids", 10, 8, 1, 10, 262, 54), ("Orionids", 10, 21, 3, 20, 95, 16),
