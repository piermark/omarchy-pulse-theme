    if cmd == "hook" and argv[2:3] == ["setup"]:   # 1.6: what to paste for each agent
        kinds = argv[3:] or list(HOOK_SETUP) + ["opencode", "pi"]
        for k in kinds:
            if k in HOOK_SETUP:
                print(hook_snippet(k) + "\n")
