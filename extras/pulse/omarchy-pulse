    # -- your year, counted: Pulse Wrapped
    def stat(self, key: str, n: float = 1, unique: str = "") -> None:
        try:
            year = time.strftime("%Y")
            f = STATE_DIR / "stats.json"
            with self.lock:
                d = json.loads(f.read_text()) if f.exists() else {}
                y = d.setdefault(year, {})
                if unique:   # count each one once (a plane's code, a quake's id), kept only as a short hash
                    import hashlib
                    h = hashlib.sha1(unique.encode()).hexdigest()[:10]
                    seen = y.setdefault("_" + key, [])
                    if h in seen:
                        return
                    seen.append(h)
                    if len(seen) > 20000:
                        del seen[:5000]
                y[key] = round(y.get(key, 0) + n, 1)
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                f.write_text(json.dumps(d))
                day = time.strftime("%Y-%m-%d")   # 1.6: each day's numbers too, for the day's video and the week's
                dd = STATE_DIR / "days.json"
                days = json.loads(dd.read_text()) if dd.exists() else {}
                today = days.setdefault(day, {})
                today[key] = round(today.get(key, 0) + n, 1)
                for old in sorted(days)[:-60]:
                    del days[old]
                dd.write_text(json.dumps(days))
        except (OSError, ValueError) as e:
            log(f"stats: {e}")

