                if u.path == "/api/package-check":
                    checks, clean = package_check(pkg)
                    self._send(200, json.dumps({"checks": checks, "ok": bool(clean), "name": (clean or {}).get("name") or pkg.get("name", "") if isinstance(pkg, dict) else "",
                                                "kind": (clean or {}).get("kind"), "design": (clean or {}).get("design"),
