# -- syslog and SNMP traps
SYSLOG_RE = re.compile(r"^<(\d{1,3})>(?:1 )?(?:(\S+ +\d+ \d\d:\d\d:\d\d|\S+T\S+) )?(\S+)? ?(.*)$")


def syslog_parse(msg: str, addr: str = "") -> dict | None:
    """An RFC 3164 or 5424 line: its severity (0 = emergency ... 7 = debug), the host and the text."""
    m = SYSLOG_RE.match(msg.strip())
    if not m:
        return None
    pri = int(m.group(1))
    return {"sev": pri % 8, "host": (m.group(3) or addr)[:48], "addr": addr, "text": (m.group(4) or "")[:160], "t": time.time()}


def trap_parse(text: str) -> dict:
    """What snmptrapd's traphandle gives on stdin: the host, its address, then the variables."""
    lines = [x.strip() for x in text.splitlines() if x.strip()]
    host = lines[0] if lines else "?"
    ip = re.findall(r"\[?(\d{1,3}(?:\.\d{1,3}){3})\]?", lines[1]) if len(lines) > 1 else []
    body = " ".join(lines[2:])
    bad = re.search(r"linkDown|1\.3\.6\.1\.6\.3\.1\.1\.5\.3|power|fan|temperature|fail|down", body, re.I)
    return {"sev": 2 if bad else 5, "host": host[:48], "addr": ip[0] if ip else "", "text": body[:160], "t": time.time()}


# -- Wi-Fi
def unifi_wifi(sta: list, devices: list) -> dict:
    names = {d.get("mac"): (d.get("name") or d.get("model") or d.get("mac", ""))[:24] for d in devices or [] if d.get("type") == "uap"}
    clients = [{"id": hashlib.sha1(str(c.get("mac")).encode()).hexdigest()[:8], "ap": names.get(c.get("ap_mac"), c.get("ap_mac", "")),
                "signal": c.get("signal") or c.get("rssi")} for c in sta or [] if not c.get("is_wired", False)]
    return {"aps": sorted(set(names.values()) | {c["ap"] for c in clients}), "clients": clients}


def mikrotik_wifi(rows: list, router: str = "router") -> dict:
    clients = []
    for r in rows or []:
        sig = r.get("signal") or r.get("signal-strength") or ""
        m = re.match(r"(-?\d+)", str(sig))
        clients.append({"id": hashlib.sha1(str(r.get("mac-address")).encode()).hexdigest()[:8],
                        "ap": f"{router} {r.get('interface', 'wifi')}"[:24], "signal": int(m.group(1)) if m else None})
    return {"aps": sorted({c["ap"] for c in clients}) or [router], "clients": clients}


def openwrt_wifi(per_iface: dict, router: str = "openwrt") -> dict:
    clients = []
    for iface, j in (per_iface or {}).items():
        for mac, c in ((j or {}).get("clients") or {}).items():
            clients.append({"id": hashlib.sha1(mac.encode()).hexdigest()[:8], "ap": f"{router} {iface}"[:24], "signal": c.get("signal")})
    return {"aps": sorted({c["ap"] for c in clients}) or [router], "clients": clients}


