    def loop_timelapse(self) -> None:
        day = time.strftime("%Y-%m-%d")
        while True:
            time.sleep(30)
            now_day = time.strftime("%Y-%m-%d")
            conf = self.conf("timelapse", default={}) or {}
            at = str(conf.get("at") or "").strip()
            out = None
            if at and re.match(r"^\d{1,2}:\d{2}$", at) and conf.get("enabled") is not False and now_day == day \
                    and time.strftime("%H:%M") >= at.zfill(5) and self.diary_done != day:
                self.diary_done = day   # 1.6: the day's video at the hour you choose (the evening), not at midnight
                if not diary_path(day, conf).exists():
                    out = make_timelapse(day, conf)
            if now_day != day:
                done, day = day, now_day
                if conf.get("enabled") is not False:
                    if at and diary_path(done, conf).exists():   # already made in the evening: drop the late pictures
                        shutil.rmtree(STATE_DIR / "timelapse" / done, ignore_errors=True)
                    else:
                        out = make_timelapse(done, conf)
                    if conf.get("weekly", True) is not False and time.strptime(done, "%Y-%m-%d").tm_wday == 6:
                        wk = make_recap(done, conf)   # 1.6: Sunday is over: the week in a minute
                        if wk:
                            self.note("timelapse", "your week as a video: " + wk.name, "info")
            if out:
                self.note("timelapse", "your day as a video: " + out.name, "info")
                if shutil.which("notify-send"):
                    subprocess.Popen(["notify-send", "Pulse · your day in a video", str(out)],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def click(self, wid: str, item: int | None = None) -> bool:
        if wid == "home" and item is not None and 0 <= item < len(self.home_lights):
            ent = str(self.home_lights[item])
            dom = ent.split(".")[0] if ent.split(".")[0] in ("light", "switch", "fan") else "homeassistant"
            try:
                self.ha(f"/api/services/{dom}/toggle", {"entity_id": ent})
            except Exception as e:   # noqa: BLE001
                log(f"home: {e}")
                return False
            return True
        if wid == "notifications":
            self.notes_cleared = time.time()
            self.drop_widget("notifications")
            return True
        if wid == "car" and item is not None and 0 <= item < len(self.car_cmds) and self.car_cmds[item]:
            cmd = self.car_cmds[item]
            if not self.car_allowed(cmd):
                return False
            threading.Thread(target=self.car_run, args=(cmd,), daemon=True).start()
            return True
        src = next((s for s in self.cfg.get("source", []) if isinstance(s, dict) and s.get("name") == wid), None)
        cmd = (src or {}).get("click")
        if not cmd:
            return False
        subprocess.Popen(["bash", "-c", cmd], env=self.src_env(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return True

    # -- music: cava listens while something plays, the scene dances
