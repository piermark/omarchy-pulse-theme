def theme_colors(c: dict) -> dict:
    """The theme's colours, with the numbered names Pulse uses filled in from the named ones when missing."""
    out = {k: v for k, v in c.items() if isinstance(v, str) and v.startswith("#")}
    for named, num in NAMED_COLORS.items():
        if named in out and num not in out:
            out[num] = out[named]
    return out


def read_theme() -> dict:
    name = theme_name()
    for d in (HOME / ".local/state/omarchy/current/theme", HOME / ".config/omarchy/current/theme",
              HOME / ".config/omarchy/themes" / name, HOME / ".local/share/omarchy/themes" / name, SYSTEM_THEMES / name):
        f = d / "colors.toml"
        if (name or d.name == "theme") and f.is_file():
            m = f.stat().st_mtime
            if _theme_cache.get("key") == (str(f), m):
                return _theme_cache["val"]
            with open(f, "rb") as fh:
                c = tomllib.load(fh)
            val = {"name": name, "colors": theme_colors(c)}
            _theme_cache.update(key=(str(f), m), val=val)
            return val
    return {"name": name, "colors": {}}


def hypr_env() -> dict:
    env = dict(os.environ)
    rt = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig or not (Path(rt) / "hypr" / sig).is_dir():
        try:
            dirs = sorted((Path(rt) / "hypr").iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
            if dirs:
                env["HYPRLAND_INSTANCE_SIGNATURE"] = dirs[0].name
        except Exception:   # noqa: BLE001
            pass
    return env


def hypr_cursor() -> list | None:
    """The pointer in layout pixels, from Hyprland's request socket (no process started)."""
    env = hypr_env()
    rt = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(str(Path(rt) / "hypr" / sig / ".socket.sock"))
            s.sendall(b"cursorpos")
            out = s.recv(64).decode("ascii", "ignore")
        x, y = (int(float(v)) for v in out.split(","))
        return [x, y]
    except (OSError, ValueError):
        return None


def process_running(names: tuple) -> bool:
    try:
        for p in os.listdir("/proc"):
            if p.isdigit():
                try:
                    if Path(f"/proc/{p}/comm").read_text().strip() in names:
                        return True
                except OSError:
                    pass
    except OSError:
        pass
    return False


def lan_route() -> dict | None:
    """The default route's gateway, interface and the local network (only private IPv4 networks)."""
    r = json.loads(subprocess.run(["ip", "-j", "-4", "route", "show", "default"], capture_output=True,
                                  timeout=5).stdout or b"[]")
    if not r or not r[0].get("gateway"):
        return None
    gw, dev = r[0]["gateway"], r[0].get("dev", "")
    addrs = json.loads(subprocess.run(["ip", "-j", "-4", "addr", "show", "dev", dev], capture_output=True,
                                      timeout=5).stdout or b"[]")
    for a in (addrs[0].get("addr_info") if addrs else []) or []:
        try:
            net = ipaddress.ip_network(f"{a['local']}/{a['prefixlen']}", strict=False)
        except (KeyError, ValueError):
            continue
        if net.is_private and ipaddress.ip_address(gw) in net:
            return {"gw": gw, "dev": dev, "src": a["local"], "prefix": a["prefixlen"], "cidr": str(net)}
    return None


def reverse_name(ip: str) -> str:
    try:
        n = socket.gethostbyaddr(ip)[0]
    except (OSError, UnicodeError):
        return ""
    n = n.split(".")[0]
    return "" if not n or n.replace("-", "").isdigit() or n == ip.split(".")[0] else n[:20]


def in_quiet_hours(spec: str, now: float | None = None) -> bool:
    m = re.match(r"^\s*(\d{1,2}):(\d{2})\s*-\s*(\d{1,2}):(\d{2})\s*$", spec or "")
    if not m:
        return False
    lt = time.localtime(now if now is not None else time.time())
    cur = lt.tm_hour * 60 + lt.tm_min
    a, b = int(m[1]) * 60 + int(m[2]), int(m[3]) * 60 + int(m[4])
    return a <= cur < b if a <= b else cur >= a or cur < b


