            rc = subprocess.call(job)
        except FileNotFoundError:
            rc = 127
        except KeyboardInterrupt:
            rc = 130
        quiet_client(f"/api/agent/{urllib.parse.quote(name)}?" + urllib.parse.urlencode(
            {"state": "done" if rc == 0 else "failed", "text": "ok" if rc == 0 else f"exit {rc}"}))
