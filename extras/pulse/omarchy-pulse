                     f"Prossimo treno Starlink alle {at}, alto {nx['max_el']} gradi.")
        if re.search(r"my city|la mia citt|streak|serie", t):
            g = self.growth_state()
            return L(f"Your city has {g['n']} buildings. Streak: {g['streak']} days, best {g['best']}.",
                     f"La tua città ha {g['n']} edifici. Serie: {g['streak']} giorni, record {g['best']}.")
        if re.search(r"my car|the car|la mia auto|l'auto|la macchina|tesla|batter", t):
            v = self.car
            if not v:
                return L("I don't see your car.", "Non vedo la tua auto.")
            ch = {"Charging": L("charging", "in carica"), "Complete": L("charged", "carica")}.get(v["state"], "")
            return L(f"Your {v['name']}: {v['battery']:.0f} percent, {v['range']:.0f} {v['unit']}" + (f", {ch}" if ch else "") + ".",
                     f"La tua auto: {v['battery']:.0f} per cento, {v['range']:.0f} {v['unit']}" + (f", {ch}" if ch else "") + ".")
        if re.search(r"next meeting|calendar|prossim[ao] (riunione|evento|appuntamento)|calendario", t):
            if not self.calendar:
                return L("Nothing in your calendar in the next hours.", "Niente in calendario nelle prossime ore.")
            e = self.calendar[0]
            at = time.strftime("%H:%M", time.localtime(e["start"]))
            return L(f"Next: {e['title']} at {at}.", f"Prossimo: {e['title']} alle {at}.")
        if re.search(r"\biss\b|space station|stazione spaziale", t):
            iss = (self.space or {}).get("iss")
            if iss:
                return L(f"The ISS is above you right now, {iss['el']:.0f} degrees up.", f"La ISS è sopra di te adesso, a {iss['el']:.0f} gradi.")
            return L("The ISS is not over you right now. I'll tell you when it passes.", "La ISS ora non è sopra di te. Ti avviso quando passa.")
        if re.search(r"weather|meteo|tempo fa|piov|rain", t):
            w = self.weather or {}
            if w.get("temp") is None:
                return L("I have no weather yet.", "Non ho ancora il meteo.")
            return L(f"{w['temp']:.0f} degrees, feels like {w.get('feels', w['temp']):.0f}.",
                     f"{w['temp']:.0f} gradi, percepiti {w.get('feels', w['temp']):.0f}.")
        if re.search(r"time is it|what time|che or[ae]", t):
            return L("It's " + time.strftime("%H:%M") + ".", "Sono le " + time.strftime("%H:%M") + ".")
        if re.search(r"agent|agenti|claude|codex|grok|drone", t):
            with self.lock:
                ag = list(self.agents.values())
            if not ag:
                return L("No agents are working right now.", "Nessun agente sta lavorando adesso.")
            words = {"working": L("working", "lavora"), "waiting": L("needs you", "ti aspetta"), "done": L("is done", "ha finito"),
                     "failed": L("failed", "è fallito"), "idle": L("is idle", "è fermo")}
            return "; ".join(f"{a['name'].replace('·', ',')} {words.get(a['state'], a['state'])}" for a in ag[:4]) + "."
        m = re.search(r"\b(city|citta|città|skyline)[\s,:;]+(?:di\s+|of\s+)?([a-zà-ü .'-]{2,40}?)[\W]*$", t)
        if m:
            k = city_key(m.group(2).strip(" .?!"))
            if not k:
                return L(f"I can't draw {m.group(2).strip()} yet.", f"Non so ancora disegnare {m.group(2).strip()}.")
            self.skyline_override = k
            said = m.group(2).strip(" .?!").title()
            return L(f"Welcome to {said}.", f"Benvenuto a {said}.")
        m = re.search(r"\b(scene|scena)\s+(sphere|sfera|skyline|orbit|calm)", t)
        if m:
            self.scene_override = {"sfera": "sphere"}.get(m.group(2), m.group(2))
            return L(f"Scene {self.scene_override}.", f"Scena {self.scene_override}.")
        # 1.6: with a local AI, a question about why or about the past goes to it, not to the quick status
        deep = bool((self.conf("ai", default={}) or {}).get("ollama")) and re.search(
            r"\b(why|when|yesterday|this morning|last night|today|perch[eé]|quando|ieri|stamattina|stanotte|oggi|cosa ho)\b", t)
        if not deep and re.search(r"server|status|stato|come (va|sta)|alert|problem|tutto bene|everything", t):
            with self.lock:
                bad = [w.get("title", w["id"]) for w in self.widgets.values() if w.get("level") in ("warn", "crit")
                       and not (w.get("private") and self.privacy())]
                n = len(self.widgets)
            if not bad:
                return L(f"Everything is fine: {n} sources, no alerts.", f"Tutto a posto: {n} sorgenti, nessun allarme.")
            return L(f"{len(bad)} need attention: " + ", ".join(bad[:4]) + ".", f"{len(bad)} da controllare: " + ", ".join(bad[:4]) + ".")
        ol = self.conf("ai", default={}) or {}
        if ol.get("ollama"):   # 1.6: a local model answers the rest, with what Pulse sees
            url = str(ol.get("ollama"))
            if not local_url(url):
                log("ai: ollama must be on this PC or your network")
            else:
                try:
                    out = ollama_answer(url, str(ol.get("model") or "llama3.2"), text, self.ai_context(),
                                        float(ol.get("timeout", 60) or 60))
                    if out:
                        return out
                except Exception as e:   # noqa: BLE001
                    log(f"ai: {e}")
        ask = str((self.conf("listen", default={}) or {}).get("ask") or "")
        if ask:
            try:
                prompt = ("You are the voice of a live desktop wallpaper. Answer in one or two short spoken sentences, "
                          f"in the language of the question. Question: {text.strip()}")
                r = subprocess.run(["bash", "-c", ask], input=prompt.encode(), capture_output=True, timeout=60, env=self.src_env())
                out = re.sub(r"\s+", " ", r.stdout.decode("utf-8", "replace")).strip()
                if out:
                    return out[:300]
            except Exception as e:   # noqa: BLE001
                log(f"listen ask: {e}")
        return L("I can start a focus, turn privacy on, fire fireworks, and tell you the status, the weather, the time, "
                 "your agents, the ISS or what you missed.",
                 "Posso avviare un focus, attivare la privacy, lanciare fuochi d'artificio e dirti lo stato, il meteo, "
                 "l'ora, i tuoi agenti, la ISS o cosa ti sei perso.")

    def ai_context(self) -> str:
        """What the local model may know: what is on your wallpaper now. No names while privacy is on."""
        priv = self.privacy()
        with self.lock:
            sysd, w = dict(self.sys or {}), dict(self.weather or {})
            ag = list(self.agents.values())
            bad = [x.get("title", x["id"]) for x in self.widgets.values() if x.get("level") in ("warn", "crit") and not x.get("private")]
            up = dict(self.updates or {})
        lines = [time.strftime("Now: %A %d %B %Y, %H:%M.")]
        if sysd.get("cpu") is not None:
            lines.append(f"PC: CPU {sysd.get('cpu')}%, RAM {sysd.get('ram')}%, disk {sysd.get('disk')}%, up {int((sysd.get('uptime') or 0) // 3600)} hours.")
        if w and not w.get("error") and w.get("temp") is not None:
            lines.append(f"Weather: {w.get('temp')}°" + (f", {w['desc']}" if w.get("desc") else "") + ".")
        if ag:
            lines.append("AI agents: " + ", ".join((("an agent" if priv else a.get("name", "agent")) + " " + a.get("state", "")) for a in ag[:6]) + ".")
        lines.append(("Needs attention: " + ", ".join(bad[:5]) + ".") if bad and not priv else ("Needs attention: " + str(len(bad)) + " items." if bad else "No alerts."))
        if up.get("n"):
            lines.append(f"Pending updates: {up['n']}" + (" (with a new kernel)" if up.get("kernel") else "") + ".")
        if self.focus:
            lines.append("A focus session is running.")
        days = day_stats()   # what you did today and yesterday ("what did I do yesterday?")
        for label, off in (("Today", 0), ("Yesterday", 1)):
            d = days.get(time.strftime("%Y-%m-%d", time.localtime(time.time() - off * 86400))) or {}
            if d:
                lines.append(f"{label}: " + ", ".join(day_card("", d)[1:]) + ".")
        with self.lock:
            past = [a for a in self.alerts if time.time() - a["t"] < 86400][-8:]
        if past:   # the alerts of the last 24 hours, with their time ("why was the server slow this morning?")
            lines.append("Alerts in the last 24 hours: " + "; ".join(
                time.strftime("%H:%M", time.localtime(a["t"])) + " " + ("an alert" if priv else f"{a['title']} {a.get('text') or ''}".strip())
                + f" ({a['level']})" for a in past) + ".")
        hist = {k: list(v) for k, v in (self.hist or {}).items() if k in ("cpu", "temp")}
        for k, v in hist.items():
            if v:
                lines.append(f"{k.upper()} in the last minutes: average {sum(v) / len(v):.0f}, peak {max(v):.0f}.")
        return "\n".join(lines)

    # -- 1.6: WLED, the room in the colour of the sphere
    def loop_wled(self) -> None:
        while True:
            time.sleep(2)
            c = self.conf("wled", default={}) or {}
            if c.get("enabled") is not True:
                continue
            hosts = [str(h) for h in (c.get("hosts") or []) if str(h).strip()][:8]
            g = self.glow
            if not hosts or not g or time.time() - g["t"] > 15:
                continue
            with self.lock:
                crit = any(w.get("level") == "crit" for w in self.widgets.values())
                party = any(f["kind"] in ("fireworks", "burst", "newyear") and time.time() - f["t"] < 8 for f in self.fx)
            mode, rgb = ("rainbow", g["rgb"]) if party else ("blink", (255, 30, 30)) if crit and c.get("alerts", True) is not False \
                else ("solid", g["rgb"])
            bri = int(c.get("brightness", 128) or 128) // (4 if self.away else 1)
            key = (mode, tuple(v // 12 for v in rgb), bri)
            if key == self.wled_sent[0] and time.time() - self.wled_sent[1] < 60:
                continue
            self.wled_sent = (key, time.time())
            body = json.dumps(wled_state(rgb, mode, bri)).encode()
            for h in hosts:
                url = (h if "//" in h else "http://" + h).rstrip("/") + "/json/state"
                if not local_url(url):
                    continue
                try:
                    urllib.request.urlopen(urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"}), timeout=3).read()
                except Exception as e:   # noqa: BLE001
                    log(f"wled {h}: {e}")

    # -- 1.6: Omarchy tips, from Hyprland's own shortcut descriptions
    def loop_tips(self) -> None:
        while True:
            c = self.conf("tips", default={}) or {}
            if c.get("enabled", True) is not False and shutil.which("hyprctl"):
                try:
                    r = subprocess.run(["hyprctl", "-j", "binds"], capture_output=True, timeout=5, env=hypr_env())
                    tips = bind_tips(json.loads(r.stdout or b"[]"))
                    extra = [str(x)[:80] for x in (c.get("extra") or [])][:40]
                    with self.lock:
                        self.tips = (tips + extra)[:200]
                except Exception as e:   # noqa: BLE001
                    log(f"tips: {e}")
            time.sleep(1800)

    # -- 1.6: pending updates as parcels, and the Arch news that asks for manual intervention
    def loop_updates(self) -> None:
        time.sleep(60)
        while True:
            c = self.conf("updates", default={}) or {}
            if c.get("enabled", True) is not False:
                try:
                    self.updates = self.read_updates(c)
                except Exception as e:   # noqa: BLE001
                    log(f"updates: {e}")
            time.sleep(max(1, float(c.get("every", 3) or 3)) * 3600)

    def read_updates(self, c: dict) -> dict:
        pk, aur = [], 0
        if shutil.which("checkupdates"):
            r = subprocess.run(["checkupdates", "--nocolor"], capture_output=True, text=True, timeout=180)
            pk = [ln.split()[0] for ln in r.stdout.splitlines() if ln.strip()]
        for helper in ("yay", "paru"):
            if c.get("aur", True) is not False and shutil.which(helper):
                r = subprocess.run([helper, "-Qua"], capture_output=True, text=True, timeout=180)
                aur = len([ln for ln in r.stdout.splitlines() if ln.strip()])
                break
        news = []
        if c.get("news", True) is not False:
            try:
                with urllib.request.urlopen(urllib.request.Request("https://archlinux.org/feeds/news/",
                                            headers={"User-Agent": "omarchy-pulse"}), timeout=15) as r:
                    news = arch_news(r.read(1_000_000).decode("utf-8", "replace"))
            except Exception as e:   # noqa: BLE001
                log(f"arch news: {e}")
        return {"n": len(pk), "aur": aur, "kernel": any(p in ("linux", "linux-lts", "linux-zen", "linux-hardened") for p in pk),
                "news": news, "t": time.time()}

    def updates_public(self) -> dict | None:
        u = self.updates
        if not u:
