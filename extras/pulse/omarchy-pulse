    # -- 1.5 beta: Pulse Net, read-only (see the net_* helpers and docs/GUIDE.md section 57)
    def net_conf(self) -> dict:
        c = self.conf("net", default={}) or {}
        return c if c.get("enabled") is True else {}

    def net_http(self, url: str, c: dict, headers: dict | None = None, data: bytes | None = None, method: str | None = None):
        """A read from one of your devices. TLS is verified unless that device says verify = false (a self-signed
        certificate on the LAN) or gives its own CA in ca_file."""
        import ssl
        ctx = None
        if url.startswith("https"):
            if c.get("verify") is False:
                ctx = ssl.create_default_context()
                ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE
            elif c.get("ca_file"):
                ctx = ssl.create_default_context(cafile=str(Path(str(c["ca_file"])).expanduser()))
        req = urllib.request.Request(url, data=data, method=method or ("POST" if data else "GET"),
                                     headers={"User-Agent": "omarchy-pulse/" + VERSION, "Accept": "application/json", **(headers or {})})
        with urllib.request.urlopen(req, timeout=15, context=ctx) as r:
            body = r.read(5_000_000)
            return json.loads(body or b"null"), r.headers

    @staticmethod
    def secret(c: dict, key: str = "token") -> str:
        """A secret from its file (key_file, token_file, password_file), never from pulse.toml itself if it can be helped."""
        f = c.get(key + "_file")
        if f:
            return Path(str(f)).expanduser().read_text().strip()
        return str(c.get(key) or "")

    def net_switches(self, c: dict, prev: dict) -> list:
        out = []
        for sw in (c.get("switch") or [])[:16]:
            name, host = str(sw.get("name") or sw.get("host")), str(sw.get("host") or "")
            try:
                args = str(sw.get("snmp") or "-v2c -c public")
                walks = {k: snmp_walk(host, oid, args) for k, oid in IF_OIDS.items() if k != "alias"}
                for k, oid in (("lldp", LLDP_REM_NAME), ("cdp", CDP_DEVICE_ID)):
                    try:
                        walks[k] = snmp_walk(host, oid, args)
                    except (OSError, subprocess.TimeoutExpired):
                        walks[k] = {}
                v = switch_view(name, walks, prev.get(name), time.time(), float(sw.get("saturate", 0.8)))
            except (OSError, subprocess.TimeoutExpired, ValueError) as e:
                v = {"name": name, "up": False, "ports": [], "peers": [], "error": str(e)[:60]}
            v["host"] = host
            if prev.get(name, {}).get("up") and not v["up"]:
                self.raise_alert("net:" + name, f"switch {name}", "not answering", "crit", speak=True)
            out.append(v)
        return out

    def net_firewall(self, c: dict, seen: set) -> dict:
        fw = c.get("firewall") or {}
        if not fw.get("url"):
            return {}
        url, kind, home = str(fw["url"]).rstrip("/"), str(fw.get("type", "fortigate")), self.location
        ev, vpn = [], None
        if kind == "fortigate":
            h = {"Authorization": "Bearer " + self.secret(fw)}
            j, _ = self.net_http(url + "/api/v2/log/memory/traffic/forward?rows=60&filter=action%3D%3Ddeny", fw, h)
            ev += fortigate_events(j, home, "deny")
            try:
                j, _ = self.net_http(url + "/api/v2/log/memory/ips?rows=20", fw, h)
                ev += fortigate_events(j, home, "ips")
                j, _ = self.net_http(url + "/api/v2/monitor/vpn/ssl", fw, h)
                vpn = fortigate_vpn(j)
            except (OSError, ValueError):
                pass
        elif kind == "opnsense":
            key = self.secret(fw, "key")
            h = {"Authorization": "Basic " + base64.b64encode(key.encode()).decode()}
            j, _ = self.net_http(url + "/api/diagnostics/firewall/log", fw, h)
            ev += opnsense_events(j if isinstance(j, list) else (j or {}).get("rows", []), home)
        elif kind == "pfsense":
            j, _ = self.net_http(url + "/api/v2/status/logs/firewall?limit=60", fw, {"X-API-Key": self.secret(fw, "key")})
            ev += pfsense_events(j, home)
        new = []
        for e in ev:
            k = hashlib.sha1(json.dumps(e, sort_keys=True, default=str).encode()).hexdigest()
            if k not in seen:
                seen.add(k)
                new.append({**e, "t": time.time()})
        if len(seen) > 5000:
            seen.clear()
        for e in new:
            if e["src"] == "ips" and e["level"] == "crit":
                self.note("net", "IPS: a serious attack blocked", "warn")
        return {"new": new[-40:], "vpn": vpn}

    def net_wifi(self, c: dict) -> dict:
        w = c.get("wifi") or {}
        if not w.get("url"):
            return {}
        url, kind = str(w["url"]).rstrip("/"), str(w.get("type", "unifi"))
        if kind == "unifi":
            site, h = str(w.get("site", "default")), {"X-API-KEY": self.secret(w, "key")}
            sta, _ = self.net_http(f"{url}/proxy/network/api/s/{site}/stat/sta", w, h)
            dev, _ = self.net_http(f"{url}/proxy/network/api/s/{site}/stat/device", w, h)
            return unifi_wifi((sta or {}).get("data", []), (dev or {}).get("data", []))
        if kind == "mikrotik":
            auth = "Basic " + base64.b64encode(f"{w.get('user', 'pulse')}:{self.secret(w, 'password')}".encode()).decode()
            for path in ("/rest/interface/wifi/registration-table", "/rest/interface/wireless/registration-table"):
                try:
                    rows, _ = self.net_http(url + path, w, {"Authorization": auth})
                    return mikrotik_wifi(rows, str(w.get("name", "router")))
                except urllib.error.HTTPError:
                    continue
            return {}
        if kind == "openwrt":   # ubus over HTTP (uhttpd-mod-ubus, with an ACL that allows hostapd get_clients)
            def call(sid, obj, meth, args):
                body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "call", "params": [sid, obj, meth, args]}).encode()
                j, _ = self.net_http(url + "/ubus", w, {"Content-Type": "application/json"}, body)
                return ((j or {}).get("result") or [1, {}])
            r = call("00000000000000000000000000000000", "session", "login", {"username": w.get("user", "root"), "password": self.secret(w, "password")})
            sid = (r[1] if len(r) > 1 else {}).get("ubus_rpc_session", "")
            per = {}
            for iface in (w.get("interfaces") or ["phy0-ap0", "phy1-ap0"])[:6]:
                res = call(sid, f"hostapd.{iface}", "get_clients", {})
                if res and res[0] == 0 and len(res) > 1:
                    per[iface] = res[1]
            return openwrt_wifi(per, str(w.get("name", "openwrt")))
        return {}

    def net_datacenter(self, c: dict, prev: dict) -> dict:
        d = c.get("datacenter") or {}
        if not d.get("url"):
            return {}
        url, kind = str(d["url"]).rstrip("/"), str(d.get("type", "proxmox"))
        if kind == "proxmox":   # an API token: PVEAPIToken=user@pam!pulse=SECRET in token_file (the PVEAuditor role is enough)
            j, _ = self.net_http(url + "/api2/json/cluster/resources", d, {"Authorization": self.secret(d)})
            cur = proxmox_view((j or {}).get("data", []))
        else:   # vCenter: a read-only user
            auth = "Basic " + base64.b64encode(f"{d.get('user')}:{self.secret(d, 'password')}".encode()).decode()
            sid, _ = self.net_http(url + "/api/session", d, {"Authorization": auth}, b"", "POST")
            h = {"vmware-api-session-id": str(sid)}
            hosts, _ = self.net_http(url + "/api/vcenter/host", d, h)
            by = {}
            for hh in (hosts or [])[:32]:
                vms, _ = self.net_http(url + "/api/vcenter/vm?hosts=" + urllib.parse.quote(hh.get("host", "")), d, h)
                by[hh.get("host")] = vms or []
            cur = vcenter_view(hosts, by)
        cur["moves"] = (dc_moves(prev, cur) + [m for m in (prev or {}).get("moves", []) if time.time() - m["t"] < 30])[-8:]
        return cur

    def net_backups(self, c: dict, prev: list) -> list:
        out, now = [], time.time()
        old = {b["name"]: b for b in prev or []}
        for b in (c.get("backup") or [])[:12]:
            name, kind = str(b.get("name") or b.get("type")), str(b.get("type", "command"))
            max_age = parse_age(b.get("max_age", "26h"))
            try:
                if kind == "restic":
                    import shlex
                    r = subprocess.run(["restic", "-r", str(b.get("repo")), "--password-file", str(Path(str(b.get("password_file"))).expanduser()),
                                        "snapshots", "--json", "--latest", "1", *shlex.split(str(b.get("args") or ""))],
                                       capture_output=True, text=True, timeout=120)
                    data = json.loads(r.stdout or "[]")
                elif kind == "pbs":
                    data, _ = self.net_http(f"{str(b['url']).rstrip('/')}/api2/json/admin/datastore/{b.get('datastore', 'backup')}/snapshots", b,
                                            {"Authorization": self.secret(b)})
                elif kind == "veeam":
                    base = str(b["url"]).rstrip("/")
                    tok, _ = self.net_http(base + "/api/oauth2/token", b, {"x-api-version": "1.1-rev0", "Content-Type": "application/x-www-form-urlencoded"},
                                           urllib.parse.urlencode({"grant_type": "password", "username": b.get("user", ""),
                                                                   "password": self.secret(b, "password")}).encode())
                    j, _ = self.net_http(base + "/api/v1/jobs/states", b, {"x-api-version": "1.1-rev0", "Authorization": "Bearer " + tok.get("access_token", "")})
                    data = next((x for x in (j or {}).get("data", []) if x.get("name") == b.get("job", name)), {})
                else:
                    import shlex
                    r = subprocess.run(shlex.split(str(b.get("command") or "false")), capture_output=True, text=True, timeout=60)
                    data = json.loads(r.stdout or "{}")
                v = backup_state(name, kind, data, max_age, now)
            except (OSError, ValueError, KeyError, subprocess.TimeoutExpired) as e:
                v = {"name": name[:24], "state": "failed", "t": None, "error": str(e)[:60]}
            if v["state"] in ("failed", "late") and old.get(name, {}).get("state") not in ("failed", "late"):
                self.raise_alert("backup:" + name, f"backup {name}", v["state"], "warn", speak=True)
                self.phone("alerts", f"backup {name}: {v['state']}", tags="truck")
            out.append(v)
        return out

    def net_intruders(self, c: dict) -> list:
        i = c.get("intruders") or {}
        kind = str(i.get("type", ""))
        if kind == "crowdsec":
            r = subprocess.run(["cscli", "alerts", "list", "-o", "json", "--since", str(i.get("since", "1h"))],
                               capture_output=True, text=True, timeout=30)
            return crowdsec_alerts(json.loads(r.stdout or "[]"))[:12]
        if kind == "wazuh" and i.get("url"):
            auth = "Basic " + base64.b64encode(f"{i.get('user', 'admin')}:{self.secret(i, 'password')}".encode()).decode()
            q = {"size": 20, "sort": [{"timestamp": "desc"}], "query": {"bool": {"filter": [
                {"range": {"rule.level": {"gte": int(i.get("min_level", 10))}}}, {"range": {"timestamp": {"gte": "now-" + str(i.get("since", "1h"))}}}]}}}
            j, _ = self.net_http(str(i["url"]).rstrip("/") + "/wazuh-alerts-*/_search", i,
                                 {"Authorization": auth, "Content-Type": "application/json"}, json.dumps(q).encode())
            return wazuh_alerts(j, int(i.get("min_level", 10)))[:12]
        return []

    def loop_net(self) -> None:
        prev_sw, seen, last = {}, set(), 0.0
        while True:
            c = self.net_conf()
            if not c or self.demo:
                time.sleep(20)
                continue
            now = time.time()
            if now - last < float(c.get("every", 60)):
                time.sleep(2)
                continue
            last, view = now, dict(self.net or {})
            for key, fn in (("switches", lambda: self.net_switches(c, prev_sw)), ("fw", lambda: self.net_firewall(c, seen)),
                            ("wifi", lambda: self.net_wifi(c)), ("dc", lambda: self.net_datacenter(c, (self.net or {}).get("dc"))),
                            ("backups", lambda: self.net_backups(c, (self.net or {}).get("backups"))), ("intruders", lambda: self.net_intruders(c))):
                try:
                    view[key] = fn()
                except Exception as e:   # noqa: BLE001 - one device that fails never stops the others
                    log(f"net {key}: {e}")
            prev_sw = {s["name"]: s for s in view.get("switches") or []}
            fw = view.get("fw") or {}
            fw["events"] = ([e for e in (self.net or {}).get("fw", {}).get("events", []) if now - e["t"] < 60] + fw.pop("new", []))[-60:]
            view["fw"] = fw
            with self.lock:
                self.net = view
            for a in view.get("intruders") or []:
                if a["level"] == "crit" and now - a["t"] < 600:
                    self.raise_alert("intruder:" + a["target"], f"intruder · {a['target']}", a["what"], "crit", speak=False)

    def bolt(self, ev: dict) -> None:
        """A device in trouble, told by syslog or by an SNMP trap: a bolt on its building, now."""
        sws = (self.net or {}).get("switches") or []
        ev["target"] = next((s["name"] for s in sws if ev.get("addr") and s.get("host") == ev["addr"] or s["name"] == ev.get("host")), ev.get("host", "?"))
        with self.lock:
            self.bolts = [b for b in self.bolts if time.time() - b["t"] < 120][-30:] + [ev]
        if ev["sev"] <= 2:
            self.note("net", f"{ev['target']}: {ev['text'][:60]}", "crit")
            self.noc_event(f"{ev['target']}: {ev['text'][:80]}")

    def loop_syslog(self) -> None:
        while True:
            s = (self.net_conf().get("syslog") or {})
            if not s.get("listen") or self.demo:
                time.sleep(20)
                continue
            host, _, port = str(s["listen"]).rpartition(":")
            allow = [ipaddress.ip_network(str(a), strict=False) for a in (s.get("allow") or ["127.0.0.1/32"])]
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                sock.bind((host or "0.0.0.0", int(port or 5514)))
                sock.settimeout(5)
            except OSError as e:
                log(f"syslog: {e}")
                time.sleep(60)
                continue
            log(f"syslog: listening on {s['listen']}")
            while self.net_conf().get("syslog", {}).get("listen") == s["listen"]:
                try:
                    data, (addr, _) = sock.recvfrom(4096)
                except socket.timeout:
                    continue
                except OSError:
                    break
                if not any(ipaddress.ip_address(addr) in n for n in allow):   # only your own devices
                    continue
                ev = syslog_parse(data.decode("utf-8", "replace"), addr)
                if ev and ev["sev"] <= int(s.get("max_severity", 3)):
                    self.bolt(ev)
            sock.close()

    def noc_event(self, text: str, level: str = "crit") -> None:
        """NOC mode: a critical event opens an incident (the screen turns red) until someone acknowledges it."""
        if not self.noc_on():
            return
        with self.lock:
            if not self.incident:
                self.incident = {"start": time.time(), "events": []}
            self.incident["events"] = (self.incident["events"] + [{"t": time.time(), "text": text[:100], "level": level}])[-12:]

    def ack(self, wid: str) -> dict:
        """The double click on a storm: run the source's ack command with the ids of its problems. Off unless the source
        has ack = "..." in pulse.toml; the page asks for a second click within 5 seconds first."""
        src = next((x for x in (self.cfg.get("source") or []) if isinstance(x, dict) and x.get("name") == wid), None)
        w = self.widgets.get(wid) or {}
        ids = [str(it.get("id")) for it in ((w.get("data") or {}).get("items") or []) if it.get("id") is not None]
        if not src or not src.get("ack") or not ids:
            return {"ok": False, "why": "no ack for this panel"}
        import shlex
        try:
            r = subprocess.run(["bash", "-c", str(src["ack"]) + " " + " ".join(shlex.quote(i) for i in ids[:50])],
                               capture_output=True, text=True, timeout=30,
                               env={**os.environ, "PATH": f"{CONF_DIR / 'sources'}:{HERE / 'sources'}:{os.environ.get('PATH', '/usr/bin')}"})
        except (OSError, subprocess.TimeoutExpired) as e:
            return {"ok": False, "why": str(e)[:80]}
        ok = r.returncode == 0
        log(f"ack {wid}: {len(ids)} problems, {'done' if ok else r.stderr.strip()[:120]}")
        self.add_fx("summary", f"{w.get('title', wid)} · {'acknowledged' if ok else 'ack failed'}")
        return {"ok": ok, "n": len(ids)}

    def noc_on(self) -> bool:
        return self.noc_override if self.noc_override is not None else self.conf("pulse", "noc", default=False) is True

    # -- 1.5: certificates, domains and anything with a date, as candles that burn down
    def loop_expiry(self) -> None:
        told: set = set()
        last, items = 0.0, []
        while True:
            c = self.conf("expiry", default={}) or {}
            if c.get("enabled") is False or not (c.get("hosts") or c.get("domains") or c.get("items")) or self.demo:
                if not self.demo:
                    self.expiry = []
                time.sleep(30)
                continue
            now = time.time()
            try:
                if now - last > float(c.get("every", 6 * 3600)):
                    last, items = now, []
                    for h in (c.get("hosts") or [])[:24]:
                        host, _, port = str(h).partition(":")
                        try:
                            r = tls_expiry(host, int(port or 443))
                            items.append({"name": host, "kind": "certificate", "at": r["at"], "valid": r["valid"]})
                        except (OSError, ValueError) as e:
                            items.append({"name": host, "kind": "certificate", "at": None, "error": str(e)[:60]})
                    for d in (c.get("domains") or [])[:24]:
                        items.append({"name": str(d), "kind": "domain", "at": whois_expiry(str(d))})
                    for it in (c.get("items") or [])[:24]:
                        try:
                            at = time.mktime(time.strptime(str(it.get("date")), "%Y-%m-%d"))
                        except (ValueError, TypeError):
                            at = None
                        items.append({"name": str(it.get("name") or "item")[:32], "kind": "date", "at": at})
                view = expiry_view(items, now, int(c.get("warn_days", 14)), int(c.get("crit_days", 3)))
                with self.lock:
                    self.expiry = view
                today = time.strftime("%Y-%m-%d")
                for x in view:
                    if x["level"] == "crit" and (x["name"], today) not in told:
                        told.add((x["name"], today))
                        what = f"{x['name']} {'expires' if (x['days'] or 0) >= 0 else 'expired'}" + (f" in {max(0, round(x['days']))} days" if x["days"] is not None and x["days"] >= 0 else "")
                        self.raise_alert("expiry:" + x["name"], f"{x['kind']} · {x['name']}", what, "warn", speak=False)
                        self.say(what, "alerts")
                        self.phone("alerts", what, tags="hourglass")
            except Exception as e:   # noqa: BLE001
                log(f"expiry: {e}")
            time.sleep(60)

    # -- 1.5: the energy of your home as the river of the city (Home Assistant)
    def loop_energy(self) -> None:
        while True:
            c = self.conf("energy", default={}) or {}
            h = self.conf("home", default={}) or {}
            if c.get("enabled") is not True or not h.get("url") or self.demo:
                if not self.demo:
                    self.energy = None
                time.sleep(20)
                continue
            try:
                def get(k):
                    if not c.get(k):
                        return None
                    st = self.ha("/api/states/" + urllib.parse.quote(str(c[k]))) or {}
                    return power_w(st.get("state"), (st.get("attributes") or {}).get("unit_of_measurement", ""))
                solar, grid, load, bat = get("solar"), get("grid"), get("load"), get("battery")
                if load is None and solar is not None and grid is not None:
                    load = max(0.0, solar + grid)
                with self.lock:
                    self.energy = {"solar": solar, "grid": grid, "load": load, "battery": bat, "t": time.time(),
                                   "peak": float(c.get("peak", 6000))}
            except Exception as e:   # noqa: BLE001
                log(f"energy: {e}")
            time.sleep(max(5, int(c.get("every", 15))))

    # -- 1.5: the holidays and the eclipses, on your own clock and over your own city
    def season_state(self, t: float | None = None) -> dict:
        """Christmas lights (8 December to 6 January, [festive]), the New Year's countdown and party, an eclipse now."""
        t = t if t is not None else self.demo_now()
        c = self.conf("festive", default={}) or {}
        out: dict = {}
        if c.get("enabled") is not False:
            lt = time.localtime(t)
            md = lt.tm_mon * 100 + lt.tm_mday
            frm, to = (int(str(c.get(k, d)).replace("-", "")) for k, d in (("lights_from", "12-08"), ("lights_to", "01-06")))
            if c.get("christmas", True) is not False and (md >= frm or md <= to):
                out["xmas"] = {"day": md in (1224, 1225, 1226), "snow": bool(self.weather and (self.weather.get("temp") or 9) <= 2)}
            if c.get("new_year", True) is not False:
                nxt = time.mktime((lt.tm_year + 1, 1, 1, 0, 0, 0, 0, 0, -1))
                if md == 1231 and nxt - t <= 3600:
                    out["newYear"] = {"left": round(nxt - t, 1), "year": lt.tm_year + 1}
                elif md == 101 and lt.tm_hour == 0 and lt.tm_min < 15:
                    out["newYear"] = {"left": 0, "year": lt.tm_year, "party": True}
        ec = self.eclipse_now(t)
        if ec:
            out["eclipse"] = ec
        return out

    def eclipse_now(self, t: float) -> dict | None:
        """An eclipse happening over you right now: how much is covered and where the Moon's disc is on the Sun."""
        for e in self.eclipse_list:
            if e["start"] - 600 <= t <= e["end"] + 600:
                lat, lon = self.location
                if e["kind"] == "solar":
                    sl = solar_local(t, lat, lon)
                    g = sl["g"]
                    import math
                    dx = (g["moon"][0] - g["sun"][0] + 540) % 360 - 180
                    dx *= math.cos(math.radians(g["sun"][1]))
                    dy = g["moon"][1] - g["sun"][1]
                    return {"kind": "solar", "type": e["type"], "obsc": round(max(0.0, sl["obsc"]), 3),
                            "mag": round(sl["mag"], 3), "off": [round(dx / g["rs"], 3), round(dy / g["rs"], 3)],
                            "rm": round(g["rm"] / g["rs"], 3), "max": e["max"], "end": e["end"]}
                ls = lunar_shadow(t)
                return {"kind": "lunar", "type": e["type"], "umag": round(ls["umag"], 3), "pmag": round(ls["pmag"], 3),
                        "max": e["max"], "end": e["end"]}
        return None

    def loop_season(self) -> None:
        said: set = set()
        computed = 0.0
        while True:
            try:
                now = self.demo_now()
                if self.location and (abs(now - computed) > 6 * 3600 or self.__dict__.get("eclipse_loc") != self.location):
                    if self.conf("night", "eclipses", default=True) is not False:
                        self.eclipse_list = eclipses(*self.location, t0=now - 86400, days=800)
                    self.eclipse_loc, computed = self.location, now
                lt = time.localtime(now)
                v = self.conf("voice", default={}) or {}
                speak = v.get("enabled") in (True, "on") and not self.away and not self.privacy()
                lang = voice_lang(v)
                st = self.season_state(now)
                ny = st.get("newYear")
                if ny and ny.get("party") and ("ny", ny["year"]) not in said:
                    said.add(("ny", ny["year"]))
                    self.add_fx("fireworks", f"HAPPY {ny['year']}")
                    self.add_fx("banner", f"HAPPY {ny['year']} · OMARCHY")
                    if speak:
                        self.say(phrase("new_year", lang, year=ny["year"]), "focus", force=True)
                    self.phone("space", phrase("new_year", lang, year=ny["year"]), tags="fireworks")
                xm = st.get("xmas")
                if xm and lt.tm_mon == 12 and lt.tm_mday == 25 and lt.tm_hour >= 9 and ("xmas", lt.tm_year) not in said:
                    said.add(("xmas", lt.tm_year))
                    self.add_fx("fireworks", phrase("xmas", lang), small=True)
                    self.say(phrase("xmas", lang), "focus")
                for e in self.eclipse_list:
                    body = {"en": ("Sun", "Moon"), "it": ("Sole", "Luna"), "es": ("Sol", "Luna"), "fr": ("Soleil", "Lune"),
                            "de": ("Sonnen", "Mond")}.get(lang, ("Sun", "Moon"))[e["kind"] == "lunar"]
                    pct = f"{round(100 * (e['obsc'] if e['kind'] == 'solar' else min(1.0, max(0.0, e['mag']))))}%"
                    if 0 < e["max"] - now <= 1800 and ("soon", e["max"]) not in said and (e["kind"] == "solar" or e["mag"] > 0):
                        said.add(("soon", e["max"]))
                        mins = round((e["max"] - now) / 60)
                        self.note("space", f"eclipse of the {'Moon' if e['kind'] == 'lunar' else 'Sun'} at {time.strftime('%H:%M', time.localtime(e['max']))}", "info")
                        self.say(phrase("eclipse_soon", lang, min=mins, body=body, pct=pct), "space")
                        self.phone("space", phrase("eclipse_soon", lang, min=mins, body=body, pct=pct), tags="new_moon")
                    if 0 <= now - e["max"] < 90 and ("max", e["max"]) not in said:
                        said.add(("max", e["max"]))
                        self.add_fx("summary", f"eclipse · {pct}")
                        self.say(phrase("eclipse_max", lang), "space")
            except Exception as e:   # noqa: BLE001
                log(f"season: {e}")
            time.sleep(1 if not self.demo else 0.5)

    # -- Starlink trains: the satellites of the last launches, when they really pass over you, lit by the Sun
    def loop_starlink(self) -> None:
        groups, fetched, planned, passes, warned, told = {}, 0.0, 0.0, [], 0.0, set()
        cache = STATE_DIR / "starlink.json"
        while True:
            c = self.conf("starlink", default={}) or {}
            if c.get("enabled") is False or self.demo or not self.location:
                time.sleep(30)
                continue
            now = time.time()
            try:
                if now - fetched > 6 * 3600:   # CelesTrak asks for no more than every few hours
                    fetched = now
                    rows = None
                    try:
                        if cache.exists() and now - cache.stat().st_mtime < 6 * 3600:
                            rows = json.loads(cache.read_text())
                    except (OSError, ValueError):
                        rows = None
                    if rows is None:
                        rows = http_json("https://celestrak.org/NORAD/elements/gp.php?GROUP=last-30-days&FORMAT=json")
                        STATE_DIR.mkdir(parents=True, exist_ok=True)
                        cache.write_text(json.dumps(rows))
                    groups = starlink_groups(rows)
                    planned = 0
                lat, lon = self.location
                if groups and now - planned > 3600:
                    planned = now
                    passes = starlink_passes(groups, lat, lon, now, 24)
                passes = [p for p in passes if p["end"] > now]
                nxt = passes[0] if passes else None
                sats = []
                if nxt and nxt["start"] - 120 <= now <= nxt["end"] + 60:   # the train is over you: every satellite
                    for o in groups.get(nxt["group"], []):
                        az, el, lit = sat_look(o, lat, lon, now)
                        if el > 0 and lit:
                            sats.append({"az": round(az, 2), "el": round(el, 2)})
                warn = float(c.get("warn", 5) or 0) * 60
                if nxt and warn and 0 < nxt["start"] - now <= warn and nxt["group"] + str(int(nxt["start"])) not in told:
                    told.add(nxt["group"] + str(int(nxt["start"])))
                    at = time.strftime("%H:%M", time.localtime(nxt["start"]))
                    side = compass(nxt["az"])
                    self.add_fx("starlink", f"Starlink train at {at} · {side} · {nxt['n']} satellites")
                    self.note("space", f"a Starlink train passes at {at}, {nxt['max_el']}° high", "info")
                    self.say(self.T("starlink", at=at, side=side), "space")
                    self.phone("space", f"Starlink train at {at}", f"look {side}, {nxt['max_el']}° high · {nxt['n']} satellites", "satellite")
                    self.stat("starlink")
                self.starlink = {"sats": sats, "next": {k: nxt[k] for k in ("start", "end", "max_el", "az", "n")} if nxt else None}
            except Exception as e:   # noqa: BLE001
                if now - warned > 3600:
                    warned = now
                    log(f"starlink: {e}")
            time.sleep(4 if self.starlink.get("sats") else 20)

    # -- thunderstorms around you: the weather of 8 points around you, so a storm comes from where it really is
    def loop_storms(self) -> None:
        warned = 0.0
        while True:
            c = self.conf("storms", default={}) or {}
            if c.get("enabled") is False or self.demo or not self.location:
                time.sleep(60)
                continue
            try:
                lat, lon = self.location
                km = float(c.get("km", 30) or 30)
                pts = [ring_point(lat, lon, b, km) for b in range(0, 360, 45)] + [(lat, lon)]
                q = ("https://api.open-meteo.com/v1/forecast?latitude=" + ",".join(f"{p[0]:.3f}" for p in pts)
                     + "&longitude=" + ",".join(f"{p[1]:.3f}" for p in pts) + "&current=weather_code,precipitation")
                j = http_json(q)
                rows = j if isinstance(j, list) else [j]
                cells = []
                for b, row in zip(list(range(0, 360, 45)) + [None], rows):
                    code = (row.get("current") or {}).get("weather_code")
                    if isinstance(code, (int, float)) and code >= 95:
                        cells.append({"az": b, "km": 0 if b is None else km, "hail": code in (96, 99)})
                lpi = None
                try:   # the lightning potential (Central Europe, ICON): how charged the air really is
                    lj = http_json(f"https://api.open-meteo.com/v1/forecast?latitude={lat:.3f}&longitude={lon:.3f}"
                                   "&hourly=lightning_potential&forecast_hours=1")
                    lpi = ((lj.get("hourly") or {}).get("lightning_potential") or [None])[0]
                except Exception:   # noqa: BLE001 - outside Europe there is none
                    pass
                self.storms = {"cells": cells, "lpi": lpi, "t": time.time()}
                if any(not c_["km"] for c_ in cells) and not self.__dict__.get("room_storm"):
                    self.room_storm = True
                    threading.Thread(target=self.loop_room_storm, daemon=True).start()
            except Exception as e:   # noqa: BLE001
                if time.time() - warned > 3600:
                    warned = time.time()
                    log(f"storms: {e}")
            time.sleep(max(300, int(c.get("every", 600) or 600)))

    def loop_room_storm(self) -> None:
        """While the thunderstorm is over you, now and then a flash of lightning in your room too."""
        import random
        try:
            while self.storms and any(not c_["km"] for c_ in self.storms.get("cells", [])):
                time.sleep(random.uniform(25, 90))
                if not self.privacy() and not self.in_meeting:
                    self.room_effect("lightning")
        finally:
            self.room_storm = False

    def set_bot(self, name: str, state: str) -> None:
        """An AI bot of yours (Grok Bot, an n8n flow, a Discord bot...) as a robot on the floor, until it says gone."""
        name = re.sub(r"[^\w.:@\- ]", "", str(name or ""))[:20].strip() or "bot"
        st = {"ok": "ok", "idle": "ok", "working": "busy", "busy": "busy", "waiting": "restart", "restart": "restart",
              "failed": "bad", "bad": "bad", "error": "bad"}.get(str(state).lower(), "gone")
        with self.lock:
            if st == "gone":
                self.bots.pop(name, None)
            else:
                self.bots[name] = {"health": "ok" if st == "busy" else st, "busy": st == "busy", "t": time.time()}

    def all_robots(self) -> list:
        now = time.time()
        bots = [{"id": "b" + __import__("hashlib").sha1(n.encode()).hexdigest()[:7], "name": n, "health": b["health"],
                 "bot": True, "busy": b.get("busy", False)} for n, b in list(self.bots.items()) if now - b["t"] < 3600]
        return (bots + list(self.robots))[:12]

