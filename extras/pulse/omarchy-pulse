# ---------------------------------------------------------------- small readers

def read_gpu():
    for p in Path("/sys/class/drm").glob("card*/device/gpu_busy_percent"):
        try:
            return float(p.read_text().strip())
        except Exception:   # noqa: BLE001
            pass
    if shutil.which("nvidia-smi"):
        try:
            r = subprocess.run(["nvidia-smi", "--query-gpu=utilization.gpu", "--format=csv,noheader,nounits"],
                               capture_output=True, text=True, timeout=3)
            return float(r.stdout.split()[0])
        except Exception:   # noqa: BLE001
            pass
    return None


# A lone core this far above the median is a bad sample, not heat.
_TEMP_OUTLIER_C = 25


def _temp_c(path: Path):
    try:
        fault = path.with_name(path.name.replace("_input", "_fault"))
        if fault.exists() and fault.read_text().strip() not in ("0", ""):
            return None
        v = int(path.read_text()) / 1000
    except Exception:   # noqa: BLE001
        return None
    return v if 0 < v < 130 else None


def _cpu_temp(package, cores):
    """°C from a package reading and per-core readings.

    One coretemp input can read ~100 °C for a single sample while the package
    and the other cores stay near idle (seen on a Core Ultra 9 285H). Taking
    the max of those inputs reports that glitch. A core more than 25 °C above
    the median is dropped. The package is kept: a hot package is still heat.
    """
    if not cores:
        return round(package, 1) if package is not None else None
    ordered = sorted(cores)
    median = ordered[len(ordered) // 2]
    plausible = [c for c in ordered if c <= median + _TEMP_OUTLIER_C]
    core_temp = max(plausible) if plausible else median
    if package is None:
        return round(core_temp, 1)
    return round(max(package, core_temp), 1)


def read_temp():
    return _read_hwmon_temp(Path("/sys/class/hwmon"))


def _read_hwmon_temp(root: Path):
    cpu_names = ("coretemp", "k10temp", "zenpower", "cpu_thermal", "macsmc_hwmon", "thinkpad")
    cores, package, fallback = [], None, None
    for hw in root.glob("hwmon*"):
        try:
            name = (hw / "name").read_text().strip()
        except Exception:   # noqa: BLE001
            continue
        cpu = name in cpu_names
        if not cpu and name != "acpitz":
            continue
        for t in hw.glob("temp*_input"):
            v = _temp_c(t)
            if v is None:
                continue
            if not cpu:
                fallback = v if fallback is None else max(fallback, v)
                continue
            label = ""
            try:
                label = t.with_name(t.name.replace("_input", "_label")).read_text().strip()
            except Exception:   # noqa: BLE001
                pass
            if label.lower().startswith("package") or label in ("Tctl", "Tdie"):
                package = v if package is None else max(package, v)
            else:
                cores.append(v)
    chosen = _cpu_temp(package, cores)
    if chosen is not None:
        return chosen
    return round(fallback, 1) if fallback is not None else None


def sound_conf(c: dict, meeting: bool = False, private: bool = False) -> dict | None:
    """The soundscape for the page: off unless you turn it on; silent in a meeting, in the quiet hours, while sharing."""
    if c.get("enabled") is not True:
        return None
    if meeting or private or in_quiet_hours(str(c.get("quiet", "23:00-08:00") or "")):
        return {"volume": 0}
    try:
        vol = max(0.0, min(1.0, float(c.get("volume", 0.25))))
    except (TypeError, ValueError):
        vol = 0.25
    return {"volume": vol, "rain": c.get("rain", True) is not False, "wind": c.get("wind", True) is not False,
            "planes": c.get("planes", True) is not False, "thunder": c.get("thunder", True) is not False,
            "events": c.get("events", True) is not False}


