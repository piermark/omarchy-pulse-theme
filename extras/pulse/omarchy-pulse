def fortigate_events(j: dict, home, kind: str = "deny") -> list:
    """FortiGate log rows (/api/v2/log/memory/traffic/forward, /api/v2/log/memory/ips) as attacks."""
    out = []
    for r in (j or {}).get("results", []) or []:
        if kind == "deny" and str(r.get("action", "")).lower() not in ("deny", "block", "blocked", "dropped"):
            continue
        sev = str(r.get("severity") or r.get("level") or "").lower()
        out.append({"src": "ips" if kind == "ips" else "deny", "country": country_code(r.get("srccountry", "")),
                    "az": attack_az(r.get("srccountry", ""), r.get("srcip", ""), home),
                    "level": "crit" if sev in ("critical", "high", "alert", "emergency") else "warn" if kind == "ips" else "info",
                    "t": float(r.get("eventtime", 0) or 0) / (1e9 if float(r.get("eventtime", 0) or 0) > 1e12 else 1) or time.time()})
    return out


def opnsense_events(rows: list, home) -> list:
    """OPNsense /api/diagnostics/firewall/log rows: the blocked ones (no country: a steady direction per address)."""
    out = []
    for r in rows or []:
        if str(r.get("action", "")).lower() != "block":
            continue
        out.append({"src": "deny", "country": "", "az": attack_az("", r.get("src", ""), home), "level": "info", "t": time.time()})
    return out


def pfsense_events(j: dict, home) -> list:
    """pfSense with the REST API package (pfrest): /api/v2/status/logs/firewall, the blocked lines."""
    out = []
    for r in (j or {}).get("data", []) or []:
        line = str(r.get("text") or r)
        if ",block," not in line:
            continue
        ips = re.findall(r"\b(?:\d{1,3}\.){3}\d{1,3}\b", line)
        out.append({"src": "deny", "country": "", "az": attack_az("", ips[0] if ips else line, home), "level": "info", "t": time.time()})
    return out


