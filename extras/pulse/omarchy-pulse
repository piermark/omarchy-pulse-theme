def gh_ci(slug: str, branch: str) -> str:
    try:
        r = subprocess.run(["gh", "run", "list", "-R", slug, "-b", branch, "-L", "1", "--json", "status,conclusion"],
                           capture_output=True, timeout=20, text=True)
        runs = json.loads(r.stdout or "[]") if r.returncode == 0 else []
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return ""
    if not runs:
        return ""
    if runs[0].get("status") != "completed":
        return "run"
    return "ok" if runs[0].get("conclusion") in ("success", "skipped", "neutral") else "fail"


def iss_at(track: list, now: float) -> dict | None:
    """The ISS position now, interpolated between the minute positions of wheretheiss.at."""
    pts = [p for p in track if isinstance(p, dict) and "timestamp" in p]
    for a, b in zip(pts, pts[1:]):
        if a["timestamp"] <= now <= b["timestamp"]:
            u = (now - a["timestamp"]) / max(1, b["timestamp"] - a["timestamp"])
            dl = (b["longitude"] - a["longitude"] + 540) % 360 - 180
            return {**a, "latitude": a["latitude"] + (b["latitude"] - a["latitude"]) * u,
                    "longitude": (a["longitude"] + dl * u + 540) % 360 - 180,
                    "altitude": a["altitude"] + (b["altitude"] - a["altitude"]) * u}
    return None



# ---------------------------------------------------------------- the real night sky (1.4): computed here, offline
# Low-precision formulas, good to a fraction of a degree for the Sun and the planets, about a degree for the Moon:
# far better than the eye needs on a wallpaper. Stars: J2000 positions of the bright ones you can recognise.

def julian(t: float) -> float:
    return t / 86400.0 + 2440587.5


def gmst_deg(jd: float) -> float:
    return (280.46061837 + 360.98564736629 * (jd - 2451545.0)) % 360


def altaz(ra: float, dec: float, lat: float, lon: float, jd: float) -> tuple:
    """Right ascension and declination (degrees) to azimuth (0 = north, 90 = east) and elevation, for (lat, lon)."""
    import math
    h = math.radians((gmst_deg(jd) + lon - ra) % 360)
    la, d = math.radians(lat), math.radians(dec)
    el = math.asin(max(-1.0, min(1.0, math.sin(la) * math.sin(d) + math.cos(la) * math.cos(d) * math.cos(h))))
    az = math.atan2(-math.sin(h) * math.cos(d), math.cos(la) * math.sin(d) - math.sin(la) * math.cos(d) * math.cos(h))
    return (math.degrees(az) + 360) % 360, math.degrees(el)


def ecl_to_eq(lon: float, lat: float, eps: float = 23.4393) -> tuple:
    import math
    lo, la, e = math.radians(lon), math.radians(lat), math.radians(eps)
    x = math.cos(la) * math.cos(lo)
    y = math.cos(e) * math.cos(la) * math.sin(lo) - math.sin(e) * math.sin(la)
    z = math.sin(e) * math.cos(la) * math.sin(lo) + math.cos(e) * math.sin(la)
    return (math.degrees(math.atan2(y, x)) + 360) % 360, math.degrees(math.asin(max(-1.0, min(1.0, z))))


def sun_ecl(jd: float) -> float:
    """The Sun's ecliptic longitude (degrees)."""
    import math
    n = jd - 2451545.0
    L, g = (280.460 + 0.9856474 * n) % 360, math.radians((357.528 + 0.9856003 * n) % 360)
    return (L + 1.915 * math.sin(g) + 0.020 * math.sin(2 * g)) % 360


def sun_radec(jd: float) -> tuple:
    return ecl_to_eq(sun_ecl(jd), 0.0, 23.439 - 0.0000004 * (jd - 2451545.0))


def moon_ecl(jd: float) -> tuple:
    """The Moon's geocentric ecliptic longitude and latitude (degrees), with its main perturbations."""
    return moon_geo(jd)[:2]


def moon_geo(jd: float) -> tuple:
    """The Moon's geocentric ecliptic longitude, latitude (degrees) and distance (Earth radii)."""
    import math
    rad, d = math.radians, jd - 2451543.5
    N, i, w = 125.1228 - 0.0529538083 * d, 5.1454, 318.0634 + 0.1643573223 * d
    e, M = 0.054900, (115.3654 + 13.0649929509 * d) % 360
    E = rad(M)
    for _ in range(8):
        E = E - (E - e * math.sin(E) - rad(M)) / (1 - e * math.cos(E))
    xv, yv = math.cos(E) - e, math.sqrt(1 - e * e) * math.sin(E)
    v, r = math.atan2(yv, xv), math.hypot(xv, yv)
    vw, Nr, ir = v + rad(w), rad(N), rad(i)
    xh = r * (math.cos(Nr) * math.cos(vw) - math.sin(Nr) * math.sin(vw) * math.cos(ir))
    yh = r * (math.sin(Nr) * math.cos(vw) + math.cos(Nr) * math.sin(vw) * math.cos(ir))
    zh = r * math.sin(vw) * math.sin(ir)
    lon, lat = math.degrees(math.atan2(yh, xh)), math.degrees(math.atan2(zh, math.hypot(xh, yh)))
    Ms = rad((356.0470 + 0.9856002585 * d) % 360)
    Mm = rad(M)
    Ls = (Ms + rad(282.9404 + 4.70935e-5 * d))
    Lm = Nr + rad(w) + rad(M)
    D, F = Lm - Ls, Lm - Nr
    s = math.sin
    lon += (-1.274 * s(Mm - 2 * D) + 0.658 * s(2 * D) - 0.186 * s(Ms) - 0.059 * s(2 * Mm - 2 * D) - 0.057 * s(Mm - 2 * D + Ms)
            + 0.053 * s(Mm + 2 * D) + 0.046 * s(2 * D - Ms) + 0.041 * s(Mm - Ms) - 0.035 * s(D) - 0.031 * s(Mm + Ms)
            - 0.015 * s(2 * F - 2 * D) + 0.011 * s(Mm - 4 * D))
    lat += (-0.173 * s(F - 2 * D) - 0.055 * s(Mm - F - 2 * D) - 0.046 * s(Mm + F - 2 * D) + 0.033 * s(F + 2 * D) + 0.017 * s(2 * Mm + F))
    dist = r * 60.2666 - 0.58 * math.cos(Mm - 2 * D) - 0.46 * math.cos(2 * D)
    return lon % 360, lat, dist


# ---------------------------------------------------------------------------- 1.5: eclipses, for where you are
DELTA_T = 69.0   # seconds, TT - UT around 2026-2028: the Moon moves half an arcsecond a second


def sun_dist(jd: float) -> float:
    """The Sun's distance (AU)."""
    import math
    g = math.radians((357.528 + 0.9856003 * (jd - 2451545.0)) % 360)
    return 1.00014 - 0.01671 * math.cos(g) - 0.00014 * math.cos(2 * g)


def eclipse_geometry(t: float, lat: float, lon: float) -> dict:
    """The Sun and the Moon seen from (lat, lon) at t: their separation and sizes (degrees), heights and directions."""
    import math
    jd = julian(t + DELTA_T)
    eps = 23.439 - 0.0000004 * (jd - 2451545.0)
    sra, sdec = ecl_to_eq(sun_ecl(jd), 0.0, eps)
    ml, mb, md = moon_geo(jd)
    mra, mdec = ecl_to_eq(ml, mb, eps)
    # from the centre of the Earth to where you are: the Moon moves by up to a degree (parallax)
    sp = 1.0 / md
    H = math.radians((gmst_deg(julian(t)) + lon - mra) % 360)
    phi, d = math.radians(lat), math.radians(mdec)
    den = math.cos(d) - math.cos(phi) * sp * math.cos(H)
    dra = math.atan2(-math.cos(phi) * sp * math.sin(H), den)
    tdec = math.atan2((math.sin(d) - math.sin(phi) * sp) * math.cos(dra), den)
    tra = (mra + math.degrees(dra)) % 360
    a1, d1, a2, d2 = math.radians(sra), math.radians(sdec), math.radians(tra), tdec
    sep = math.degrees(math.acos(max(-1.0, min(1.0, math.sin(d1) * math.sin(d2) + math.cos(d1) * math.cos(d2) * math.cos(a1 - a2)))))
    s_az, s_alt = altaz(sra, sdec, lat, lon, julian(t))
    m_az, m_alt = altaz(tra, math.degrees(tdec), lat, lon, julian(t))
    rs = 959.63 / 3600 / sun_dist(jd)
    rm = math.degrees(math.asin(0.272481 * sp)) * (1 + math.sin(math.radians(max(0.0, m_alt))) * sp)
    return {"sep": sep, "rs": rs, "rm": rm, "sun": (s_az, s_alt), "moon": (m_az, m_alt), "md": md,
            "ml": ml, "mb": mb, "sl": sun_ecl(jd)}


def disc_overlap(sep: float, r1: float, r2: float) -> float:
    """How much of a disc of radius r1 a disc of radius r2 covers at a distance sep (0..1)."""
    import math
    if sep >= r1 + r2:
        return 0.0
    if sep <= abs(r2 - r1):
        return 1.0 if r2 >= r1 else (r2 * r2) / (r1 * r1)
    a = r1 * r1 * math.acos((sep * sep + r1 * r1 - r2 * r2) / (2 * sep * r1))
    b = r2 * r2 * math.acos((sep * sep + r2 * r2 - r1 * r1) / (2 * sep * r2))
    c = 0.5 * math.sqrt(max(0.0, (-sep + r1 + r2) * (sep + r1 - r2) * (sep - r1 + r2) * (sep + r1 + r2)))
    return (a + b - c) / (math.pi * r1 * r1)


def solar_local(t: float, lat: float, lon: float) -> dict:
    g = eclipse_geometry(t, lat, lon)
    mag = (g["rs"] + g["rm"] - g["sep"]) / (2 * g["rs"])
    return {"mag": mag, "obsc": disc_overlap(g["sep"], g["rs"], g["rm"]), "g": g}


def lunar_shadow(t: float) -> dict:
    """The Moon against the Earth's shadow (geocentric): the umbral and penumbral magnitudes."""
    import math
    jd = julian(t + DELTA_T)
    ml, mb, md = moon_geo(jd)
    sl, R = sun_ecl(jd), sun_dist(jd)
    al, ab = math.radians((sl + 180) % 360), 0.0
    m1, b1 = math.radians(ml), math.radians(mb)
    sep = math.degrees(math.acos(max(-1.0, min(1.0, math.sin(b1) * math.sin(ab) + math.cos(b1) * math.cos(ab) * math.cos(m1 - al)))))
    pm = math.degrees(math.asin(1.0 / md))
    ps, ss = 8.794 / 3600 / R, 959.63 / 3600 / R
    rm = math.degrees(math.asin(0.272481 / md))
    umbra, pen = 1.02 * (0.99834 * pm + ps - ss), 1.02 * (0.99834 * pm + ps + ss)
    return {"umag": (umbra + rm - sep) / (2 * rm), "pmag": (pen + rm - sep) / (2 * rm), "sep": sep}


def syzygies(t0: float, days: float, full: bool) -> list:
    """The new (or full) moons between t0 and t0 + days, to a minute."""
    out, step, t = [], 6 * 3600, t0
    target = 180.0 if full else 0.0
    def el(x):
        jd = julian(x + DELTA_T)
        return ((moon_ecl(jd)[0] - sun_ecl(jd) - target + 180) % 360) - 180
    prev = el(t)
    while t < t0 + days * 86400:
        n = el(t + step)
        if prev < 0 <= n and n - prev < 90:
            lo, hi = t, t + step
            for _ in range(30):
                mid = (lo + hi) / 2
                if el(mid) < 0:
                    lo = mid
                else:
                    hi = mid
            out.append((lo + hi) / 2)
        prev, t = n, t + step
    return out


def eclipses(lat: float, lon: float, t0: float | None = None, days: float = 800) -> list:
    """The eclipses you can see from (lat, lon) in the next `days`: the Sun partly or wholly hidden while it is up,
    the Moon in the Earth's shadow while it is up. Times to a few minutes, sizes to a few percent (a wallpaper, not
    an almanac): each one with its start, its greatest moment, its end and how much is covered."""
    import math
    t0 = t0 if t0 is not None else time.time()
    out = []
    for tn in syzygies(t0 - 86400, days + 1, False):
        jd = julian(tn + DELTA_T)
        if abs(moon_geo(jd)[1]) > 1.6:
            continue
        best, first, last = None, None, None
        for k in range(-260, 261):   # every minute, four hours and twenty either side of the new moon
            tt = tn + k * 60
            sl = solar_local(tt, lat, lon)
            up = sl["g"]["sun"][1] > -0.8
            if sl["mag"] > 0 and up:
                first = first or tt
                last = tt
                if not best or sl["mag"] > best[1]["mag"]:
                    best = (tt, sl)
        if not best or best[0] < t0 - 6 * 3600:
            continue
        tm, sl = best
        t_min = tm
        for k in range(-60, 61, 5):   # to five seconds
            x = solar_local(t_min + k, lat, lon)
            if x["mag"] > sl["mag"]:
                tm, sl = t_min + k, x
        g = sl["g"]
        kind = "total" if g["rm"] >= g["rs"] and sl["mag"] >= 1 else "annular" if g["sep"] < g["rs"] - g["rm"] else "partial"
        out.append({"kind": "solar", "type": kind, "start": first, "max": tm, "end": last,
                    "mag": round(sl["mag"], 3), "obsc": round(sl["obsc"], 3), "alt": round(g["sun"][1], 1),
                    "az": round(g["sun"][0], 1)})
    for tf in syzygies(t0 - 86400, days + 1, True):
        x = lunar_shadow(tf)
        if x["pmag"] < -0.6:
            continue
        best, first, last = None, None, None
        for k in range(-300, 301, 2):
            tt = tf + k * 60
            ls = lunar_shadow(tt)
            if ls["pmag"] <= 0:
                continue
            first = first or tt
            last = tt
            if not best or ls["pmag"] > best[1]["pmag"]:
                best = (tt, ls)
        if not best or best[0] < t0 - 6 * 3600:
            continue
        tm, ls = best
        kind = "total" if ls["umag"] >= 1 else "partial" if ls["umag"] > 0 else "penumbral"
        # can you see it: is the Moon above your horizon at some point of it
        seen, alt_max = False, -90.0
        for tt in range(int(first), int(last) + 1, 300):
            alt = eclipse_geometry(tt, lat, lon)["moon"][1]
            alt_max = max(alt_max, alt)
            seen = seen or alt > 0
        if not seen:
            continue
        out.append({"kind": "lunar", "type": kind, "start": first, "max": tm, "end": last,
                    "mag": round(ls["umag"], 3), "pmag": round(ls["pmag"], 3),
                    "alt": round(eclipse_geometry(tm, lat, lon)["moon"][1], 1), "altMax": round(alt_max, 1)})
    return sorted(out, key=lambda e: e["max"])


def moon_phase(jd: float) -> dict:
    """How much of the Moon is lit (0..1), whether it grows, its age in days and its name."""
    import math
    elong = (moon_ecl(jd)[0] - sun_ecl(jd)) % 360
    lit = (1 - math.cos(math.radians(elong))) / 2
    waxing = elong < 180
    age = elong / 360 * 29.530589
    name = ("new moon" if lit < 0.03 else "full moon" if lit > 0.97 else
            ("first quarter" if waxing else "last quarter") if abs(lit - 0.5) < 0.06 else
            ("waxing crescent" if waxing else "waning crescent") if lit < 0.5 else ("waxing gibbous" if waxing else "waning gibbous"))
    return {"lit": round(lit, 3), "waxing": waxing, "age": round(age, 1), "name": name}


