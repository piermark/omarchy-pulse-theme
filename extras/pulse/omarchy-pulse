def snmp_parse(out: str, base: str) -> dict:
    """`snmpbulkwalk -On -Oq -Oe` lines (".OID value") into {index: value} under base."""
    res, pre = {}, "." + base.strip(".") + "."
    for line in out.splitlines():
        oid, _, val = line.strip().partition(" ")
        if oid.startswith(pre):
            res[oid[len(pre):]] = val.strip().strip('"')
    return res


def snmp_walk(host: str, base: str, args: str = "-v2c -c public", timeout: int = 3) -> dict:
    exe = shutil.which("snmpbulkwalk") or shutil.which("snmpwalk")
    if not exe:
        raise OSError("install net-snmp (sudo pacman -S net-snmp)")
    import shlex
    r = subprocess.run([exe, *shlex.split(args), "-On", "-Oq", "-Oe", "-t", str(timeout), "-r", "1", host, base],
                       capture_output=True, text=True, timeout=timeout * 8 + 10)
    if r.returncode and not r.stdout:
        raise OSError((r.stderr.strip().splitlines() or ["snmp error"])[-1][:80])
    return snmp_parse(r.stdout, base)


def switch_view(name: str, walks: dict, prev: dict | None, now: float, saturate: float = 0.8) -> dict:
    """A switch as a building: its ports as windows (up, down, errors, how busy), its neighbours (LLDP or CDP)."""
    ports, nb = [], {}
    pv = (prev or {}).get("_raw", {})
    dt = max(1.0, now - (prev or {}).get("_t", now - 60))
    for idx, typ in sorted(walks.get("type", {}).items(), key=lambda kv: int(kv[0]) if kv[0].isdigit() else 0):
        if typ not in PORT_TYPES:
            continue
        up = walks.get("oper", {}).get(idx) == "1"
        err = int(walks.get("inerr", {}).get(idx, "0") or 0)
        ib, ob = int(walks.get("in", {}).get(idx, "0") or 0), int(walks.get("out", {}).get(idx, "0") or 0)
        speed = int(walks.get("speed", {}).get(idx, "0") or 0) * 1_000_000 / 8   # bytes a second
        p0 = pv.get(idx)
        util = 0.0
        if p0 and speed > 0:
            util = min(1.0, max(0.0, max(ib - p0[1], ob - p0[2]) / dt / speed))
        ports.append({"i": idx, "name": walks.get("descr", {}).get(idx, idx)[:24], "up": up,
                      "err": bool(p0 and err > p0[0]), "util": round(util, 3)})
    for key, v in walks.get("lldp", {}).items():
        parts = key.split(".")
        if len(parts) >= 3 and v:
            nb[parts[-2]] = v[:32]
    for key, v in walks.get("cdp", {}).items():
        parts = key.split(".")
        if len(parts) >= 2 and v:
            nb.setdefault(parts[-2], v.split(".")[0][:32])
    for p in ports:
        if p["i"] in nb:
            p["peer"] = nb[p["i"]]
            p["jam"] = p["util"] >= saturate
    raw = {idx: (int(walks.get("inerr", {}).get(idx, "0") or 0), int(walks.get("in", {}).get(idx, "0") or 0),
                 int(walks.get("out", {}).get(idx, "0") or 0)) for idx in walks.get("type", {})}
    return {"name": name, "up": bool(walks.get("type")), "ports": ports[:96], "peers": sorted(set(nb.values())),
            "_raw": raw, "_t": now}


