def ollama_answer(url: str, model: str, question: str, context: str, timeout: float = 60) -> str:
    """A free question answered by a local model (Ollama), with a short snapshot of what Pulse sees. Local only."""
    prompt = ("You are the voice of Omarchy Pulse, a live desktop wallpaper. Answer in one or two short spoken "
              "sentences, in the language of the question, from these facts when they help:\n" + context +
              "\nQuestion: " + question.strip())
    body = json.dumps({"model": model, "prompt": prompt, "stream": False, "options": {"num_predict": 120}}).encode()
    req = urllib.request.Request(url.rstrip("/") + "/api/generate", data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        out = json.loads(r.read(2_000_000)).get("response", "")
    return re.sub(r"\s+", " ", out).strip()[:400]


def local_url(url: str) -> bool:
    """Ollama and WLED must be on this PC or the LAN: never a host on the internet."""
    import ipaddress as _ip
    host = urllib.parse.urlsplit(url if "//" in url else "http://" + url).hostname or ""
    if host in ("localhost",) or host.endswith(".local") or host.endswith(".lan"):
        return True
    try:
        a = _ip.ip_address(socket.gethostbyname(host))
        return a.is_private or a.is_loopback or a.is_link_local
    except (OSError, ValueError):
        return False


def wled_state(rgb, mode: str = "solid", bri: int = 128) -> dict:
    """The WLED JSON API state for a colour: solid, blink (an alert) or rainbow (fireworks)."""
    fx = {"solid": 0, "blink": 1, "breathe": 2, "rainbow": 9}.get(mode, 0)
    return {"on": True, "bri": max(1, min(255, int(bri))), "seg": [{"col": [[int(c) for c in rgb]], "fx": fx, "sx": 160}]}


def image_rgb(path: str, w: int = 48, h: int = 27) -> list:
    """A picture as w*h RGB pixels, through ffmpeg (no image library needed)."""
    r = subprocess.run(["ffmpeg", "-loglevel", "error", "-i", path, "-vf", f"scale={w}:{h}", "-frames:v", "1",
                        "-f", "rawvideo", "-pix_fmt", "rgb24", "-"], capture_output=True, timeout=60)
    d = r.stdout
    if len(d) < w * h * 3:
        raise OSError("ffmpeg could not read the picture")
    return [tuple(d[i:i + 3]) for i in range(0, w * h * 3, 3)]


def palette_from(px: list) -> dict:
    """The same palette the page takes from a picture: a dark background, two accents, light text; then a whole
    16-colour terminal palette around them, for a theme to review."""
    import colorsys
    lum = sorted(px, key=lambda p: 0.2126 * p[0] + 0.7152 * p[1] + 0.0722 * p[2])
    dark = [sum(p[i] for p in lum[:max(1, len(lum) // 5)]) / max(1, len(lum) // 5) for i in range(3)]
    bins = [[0.0, 0.0, 0.0, 0.0] for _ in range(24)]
    for r, g, b in px:
        h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        if s > 0.3 and v > 0.3:
            w = s * v
            bn = bins[int(h * 24) % 24]
            bn[0] += w; bn[1] += r * w; bn[2] += g * w; bn[3] += b * w   # noqa: E702
    order = sorted(range(24), key=lambda k: -bins[k][0])
    avg = lambda k: [bins[k][i] / bins[k][0] for i in (1, 2, 3)]   # noqa: E731
    bright = lambda c: [min(255, x * max(1, 210 / (max(c) or 1))) for x in c]   # noqa: E731
    mixc = lambda a, b, k: [a[i] + (b[i] - a[i]) * k for i in range(3)]   # noqa: E731
    a1 = bright(avg(order[0])) if bins[order[0]][0] else [122, 162, 247]
    a2 = None
    for k in order[1:]:
        if bins[k][0] > bins[order[0]][0] * 0.05 and min(abs(k - order[0]), 24 - abs(k - order[0])) >= 4:
            a2 = bright(avg(k))
            break
    a2 = a2 or mixc(a1, [255, 255, 255], 0.45)
    bg = mixc(dark, [0, 0, 0], 0.45)
    fg = mixc([238, 238, 242], a1, 0.12)
    hx = lambda c: "#" + "".join(f"{int(round(max(0, min(255, x)))):02x}" for x in c)   # noqa: E731
    def hue(deg, s=0.55, v=0.85):   # the classic terminal colours (red, green, yellow, blue), soft
        return [x * 255 for x in colorsys.hsv_to_rgb((deg / 360) % 1, s, v)]
    red, green, yellow, blue = hue(355), hue(120), hue(45), hue(220)
    base = {"color0": bg, "color1": red, "color2": green, "color3": yellow, "color4": blue, "color5": a2, "color6": a1,
            "color7": fg, "color8": mixc(bg, fg, 0.35)}
    for i in range(1, 7):
        base[f"color{i + 8}"] = mixc(base[f"color{i}"], [255, 255, 255], 0.2)
    base["color15"] = mixc(fg, [255, 255, 255], 0.5)
    out = {"accent": hx(a1), "cursor": hx(a1), "foreground": hx(fg), "background": hx(bg),
           "selection_foreground": hx(bg), "selection_background": hx(a1)}
    out.update({k: hx(v) for k, v in base.items()})
    return out


def theme_from_picture(pic: str, name: str) -> Path:
    """omarchy-pulse theme from-wallpaper: a new Omarchy theme folder (colors.toml and the picture) to review by
    hand. Pulse never applies it: omarchy-theme-set NAME when you like it."""
    if not re.match(r"^[a-z0-9][a-z0-9-]{1,40}$", name):
        raise ValueError("a theme name: a-z, 0-9 and -")
    src = Path(pic).expanduser()
    if not src.is_file() or src.suffix.lower() not in WALL_TYPES:
        raise ValueError("a picture: jpg, png or webp")
    d = HOME / ".config/omarchy/themes" / name
    if d.exists():
        raise ValueError(f"{d} already exists")
    pal = palette_from(image_rgb(str(src)))
    (d / "backgrounds").mkdir(parents=True)
    shutil.copy2(src, d / "backgrounds" / ("1-" + src.name))
    lines = [f"# {name}: made by Omarchy Pulse from {src.name}. Review every colour before you use it."]
    lines += [f'{k} = "{v}"' for k, v in pal.items()]
    (d / "colors.toml").write_text("\n".join(lines) + "\n")
    return d


def bind_tips(binds: list) -> list:
    """Omarchy's own shortcuts with their descriptions (Hyprland bindd), as tips: 'SUPER + SPACE · Launch apps'."""
    mods = [(64, "SUPER"), (8, "ALT"), (4, "CTRL"), (1, "SHIFT")]
    out = []
    for b in binds or []:
        desc = str(b.get("description") or "").strip()
        key = str(b.get("key") or "").strip()
        if not desc or not key or b.get("submap") or desc.lower() == key.lower():
            continue
        m = int(b.get("modmask") or 0)
        combo = " + ".join([n for v, n in mods if m & v] + [key.upper() if len(key) == 1 else key])
        out.append(f"{combo} · {desc}"[:80])
    return sorted(set(out))


def arch_news(xml: str, days: float = 30, now: float | None = None) -> list:
    """Arch Linux news that asks for manual intervention before you update."""
    import email.utils
    now = now or time.time()
    out = []
    for item in re.findall(r"<item>(.*?)</item>", xml, re.S):
        title = re.sub(r"<!\[CDATA\[|\]\]>", "", (re.findall(r"<title>(.*?)</title>", item, re.S) or [""])[0]).strip()
        link = (re.findall(r"<link>(.*?)</link>", item, re.S) or [""])[0].strip()
        date = (re.findall(r"<pubDate>(.*?)</pubDate>", item, re.S) or [""])[0].strip()
        try:
            t = email.utils.parsedate_to_datetime(date).timestamp()
        except (TypeError, ValueError):
            continue
        if now - t <= days * 86400 and re.search(r"manual intervention|requires? (?:manual|user) action", title + item, re.I):
            out.append({"title": title[:120], "link": link, "t": t})
    return out


def hypr_floors(workspaces: list, clients: list, active: int) -> list:
    """Hyprland's workspaces as the floors of a tower: each window a lit room (the app's class, never its title)."""
    floors = {}
    for w in workspaces or []:
        wid = int(w.get("id", 0))
        if wid > 0:
            floors[wid] = {"id": wid, "active": wid == active, "apps": []}
    for c in clients or []:
        wid = int((c.get("workspace") or {}).get("id", 0))
        if wid in floors and c.get("mapped", True):
            floors[wid]["apps"].append(str(c.get("class") or c.get("initialClass") or "app")[:24].lower())
    return [floors[k] for k in sorted(floors)][:12]


