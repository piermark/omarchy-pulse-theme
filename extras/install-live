#!/bin/bash
# Omarchy Pulse: turns the wallpaper live. Installs the engine, its packages, a user unit, the theme-set hook and the
# login start. (c) 2026 Marco Porro (x.com/MarcoPorro), MIT. Made for Omarchy 4.5.
#   install-live             set it up: live with the pulse theme
#   install-live --always    live with every Omarchy theme (it takes each theme's colours)
#   install-live --theme     back to: live only with the pulse theme
#   install-live --remove    undo everything (your pulse.toml and the theme stay)
#   install-live --native    draw it natively (pulse-native, a ready binary from the release; recommended on a PC)
#   install-live --web       draw it with the web page (the default; OmarchyTV always uses it)
# Without --native or --web, it asks once on a PC (x86_64) whether to draw natively.
set -e
here="$(cd "$(dirname "$0")" && pwd)"
share="$HOME/.local/share/omarchy-pulse"
bin="$HOME/.local/bin/omarchy-pulse"
hook_dir="$HOME/.config/omarchy/hooks/theme-set.d"
hook="$hook_dir/omarchy-pulse"
unit_dir="$HOME/.config/systemd/user"
unit="$unit_dir/omarchy-pulse.service"
desktop="$HOME/.config/autostart/omarchy-pulse.desktop"
cfg_dir="$HOME/.config/omarchy-pulse"
conf="$cfg_dir/live.conf"

if [[ ${1:-} == --remove ]]; then
  systemctl --user stop omarchy-pulse.service 2>/dev/null || true
  rm -rf "$unit_dir/omarchy-pulse.service.d"
  rm -f "$hook" "$desktop" "$unit" "$bin" "$conf"
  rm -rf "$share"
  systemctl --user daemon-reload 2>/dev/null || true
  echo "Omarchy Pulse removed. Your sources are still in $cfg_dir (delete the folder to forget them)."
  exit 0
fi
renderer=""
case "${1:-}" in
  --always) mkdir -p "$cfg_dir"; echo "ALWAYS=1" > "$conf" ;;
  --theme) mkdir -p "$cfg_dir"; echo "ALWAYS=0" > "$conf" ;;
  --native) renderer=native ;;
  --web) renderer=web ;;
  "") ;;
  *) echo "usage: install-live [--always|--theme|--native|--web|--remove]"; exit 1 ;;
esac

need=()
python3 -c "import gi" 2>/dev/null || need+=(python-gobject)
python3 -c "import gi; gi.require_version('GtkLayerShell','0.1')" 2>/dev/null || need+=(gtk-layer-shell)
python3 -c "import gi; gi.require_version('WebKit2','4.1')" 2>/dev/null || need+=(webkit2gtk-4.1)
command -v ffmpeg >/dev/null || need+=(ffmpeg)
command -v playerctl >/dev/null || need+=(playerctl)
if ((${#need[@]})); then
  echo "Installing: ${need[*]}"
  sudo pacman -S --needed --noconfirm "${need[@]}"
fi

mkdir -p "$share" "$(dirname "$bin")" "$hook_dir" "$unit_dir" "$(dirname "$desktop")" "$cfg_dir/sources"
cp -r "$here/pulse/." "$share/"
install -m 755 "$here/pulse-live" "$share/pulse-live"
install -m 755 "$here/pulse-native-get" "$share/pulse-native-get"
# the key that signs pulse-native's releases (when there is one): what pulse-native-get checks them against
[[ -f $here/native-allowed-signers ]] && install -m 644 "$here/native-allowed-signers" "$share/native-allowed-signers"
chmod +x "$share/omarchy-pulse" "$share"/sources/*
ln -sf "$share/omarchy-pulse" "$bin"
[[ -f $cfg_dir/pulse.toml ]] || cp "$share/pulse.toml" "$cfg_dir/pulse.toml"
if grep -q '^city = ""' "$cfg_dir/pulse.toml" && [[ -t 0 ]]; then
  read -r -p "City for the weather (empty to skip): " city
  [[ -n $city ]] && sed -i "s|^city = \"\"|city = \"${city//|/}\"|" "$cfg_dir/pulse.toml"
fi
cat > "$hook" <<EOF
#!/bin/bash
exec "$share/pulse-live" "\$@"
EOF
chmod +x "$hook"
cat > "$unit" <<EOF
[Unit]
Description=Omarchy Pulse live wallpaper
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
ExecStart=$share/pulse-live --run
Restart=always
RestartSec=3
RestartPreventExitStatus=77
SuccessExitStatus=77
Environment=PYTHONUNBUFFERED=1
EOF
cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Omarchy Pulse
Comment=The live wallpaper of the pulse theme (extras/install-live --remove to undo)
Exec=$share/pulse-live --login
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF
systemctl --user daemon-reload
systemctl --user stop omarchy-pulse.service 2>/dev/null || true
"$share/pulse-live"
# Which renderer draws it: asked once on a PC, unless --native or --web said so (or it is already native)
choice="$cfg_dir/renderer"   # the answer, so it is asked only once
[[ -n $renderer ]] && echo "$renderer" > "$choice"
if [[ -z $renderer && ! -s $choice && ! -f $unit_dir/omarchy-pulse.service.d/native.conf && $(uname -m) == x86_64 && -t 0 ]]; then
  echo
  echo "Pulse can be drawn natively on the GPU (pulse-native: lighter, smoother, the worlds only it has),"
  echo "or by the web page as always. You can switch any time: omarchy-pulse native on / off."
  read -r -p "Draw it natively? [Y/n] " yn
  [[ ${yn,,} == n* ]] && renderer=web || renderer=native
  echo "$renderer" > "$choice"
fi
if [[ $renderer == native ]]; then
  "$share/pulse-native-get" || echo "pulse-native could not be installed: the web wallpaper draws Pulse (omarchy-pulse native on to try again)."
elif [[ $renderer == web && -f $unit_dir/omarchy-pulse.service.d/native.conf ]]; then
  "$share/install-native" --off 2>/dev/null || true
fi
echo
echo "Done. Omarchy Pulse is live$( [[ -f $conf ]] && grep -q ALWAYS=1 "$conf" && echo " with every theme" || echo " with the pulse theme")."
echo "  your sources:   $cfg_dir/pulse.toml   (saved = on the wallpaper in a few seconds)"
echo "  push anything:  omarchy-pulse push hello \"it works\""
echo "  privacy:        omarchy-pulse privacy toggle   (automatic while you share the screen)"
echo "  logs:           journalctl --user -u omarchy-pulse -f"
